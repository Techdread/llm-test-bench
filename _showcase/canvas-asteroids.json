 "rating": "5/5",
 "kind": "html",
 "prompt": "Build the classic Asteroids game on a single HTML page with vanilla JavaScript and a canvas — no libraries. Vector-line aesthetic, ship with rotation and thrust momentum, screen wrap-around, asteroids that split into smaller pieces when shot, occasional UFO, hyperspace jump on a key press, progressive levels, lives, score, and a localStorage high-score table. Add simple retro sound effects synthesized with the Web Audio API (no audio files).",
 "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>VECTOR ASTEROIDS</title>\n    <style>\n        body {\n            margin: 0;\n            padding: 0;\n            background-color: #000;\n            color: #0f0;\n            font-family: 'Courier New', Courier, monospace;\n            overflow: hidden;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            height: 100vh;\n        }\n\n        #game-container {\n            position: relative;\n            box-shadow: 0 0 20px rgba(0, 255, 0, 0.2);\n        }\n\n        canvas {\n            display: block;\n            background-color: #000;\n            border: 2px solid #0f0;\n        }\n\n        #ui-layer {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            text-align: center;\n        }\n\n        .hud {\n            position: absolute;\n            top: 20px;\n            left: 20px;\n            right: 20px;\n            display: flex;\n            justify-content: space-between;\n            font-size: 24px;\n            pointer-events: none;\n        }\n\n        .screen {\n            background: rgba(0, 0, 0, 0.85);\n            padding: 30px;\n            border: 2px solid #0f0;\n            pointer-events: auto;\n            display: none;\n        }\n\n        .screen.active {\n            display: block;\n        }\n\n        h1 {\n            font-size: 48px;\n            margin: 0 0 20px 0;\n            text-shadow: 0 0 10px #0f0;\n        }\n\n        .btn {\n            background: transparent;\n            color: #0f0;\n            border: 2px solid #0f0;\n            padding: 10px 20px;\n            font-family: inherit;\n            font-size: 20px;\n            cursor: pointer;\n            transition: all 0.2s;\n            margin-top: 20px;\n        }\n\n        .btn:hover {\n            background: #0f0;\n            color: #000;\n        }\n\n        #high-scores {\n            margin-top: 20px;\n            text-align: left;\n            display: inline-block;\n        }\n\n        .score-row {\n            display: flex;\n            justify-content: space-between;\n            width: 250px;\n            margin: 5px 0;\n        }\n\n        .controls-hint {\n            font-size: 14px;\n            margin-top: 20px;\n            color: #0a0;\n        }\n    </style>\n</head>\n<body>\n\n<div id=\"game-container\">\n    <canvas id=\"gameCanvas\"></canvas>\n    <div id=\"ui-layer\">\n        <div class=\"hud\" id=\"hud\">\n            <div>SCORE: <span id=\"scoreVal\">0</span></div>\n            <div>LIVES: <span id=\"livesVal\">3</span></div>\n            <div>LEVEL: <span id=\"levelVal\">1</span></div>\n        </div>\n\n        <!-- Start Screen -->\n        <div id=\"start-screen\" class=\"screen active\">\n            <h1>VECTOR ASTEROIDS</h1>\n            <button class=\"btn\" onclick=\"game.start()\">START MISSION</button>\n            <div class=\"controls-hint\">\n                W / UP: Thrust<br>\n                A,D / LEFT,RIGHT: Rotate<br>\n                SPACE: Fire<br>\n                SHIFT: Hyperspace Jump\n            </div>\n            <div id=\"high-scores\"></div>\n        </div>\n\n        <!-- Game Over Screen -->\n        <div id=\"game-over-screen\" class=\"screen\">\n            <h1>GAME OVER</h1>\n            <p>FINAL SCORE: <span id=\"finalScore\">0</span></p>\n            <button class=\"btn\" onclick=\"game.start()\">TRY AGAIN</button>\n        </div>\n    </div>\n</div>\n\n<script>\n/** \n * AUDIO ENGINE (Web Audio API)\n */\nconst AudioEngine = (() => {\n    let ctx = null;\n\n    const init = () => {\n        if (!ctx) ctx = new (window.AudioContext || window.webkitAudioContext)();\n    };\n\n    const playTone = (freq, type, duration, volume = 0.1, slide = 0) => {\n        if (!ctx) return;\n        const osc = ctx.createOscillator();\n        const gain = ctx.createGain();\n        osc.type = type;\n        osc.frequency.setValueAtTime(freq, ctx.currentTime);\n        if (slide !== 0) {\n            osc.frequency.exponentialRampToValueAtTime(freq + slide, ctx.currentTime + duration);\n        }\n        gain.gain.setValueAtTime(volume, ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + duration);\n        osc.connect(gain);\n        gain.connect(ctx.destination);\n        osc.start();\n        osc.stop(ctx.currentTime + duration);\n    };\n\n    return {\n        init,\n        shoot: () => playTone(800, 'square', 0.1, 0.05),\n        thrust: () => playTone(100, 'sawtooth', 0.1, 0.03),\n        explode: () => playTone(200, 'sawtooth', 0.4, 0.1, -150),\n        ufo: () => playTone(600, 'sine', 0.2, 0.05, 200),\n        jump: () => playTone(100, 'square', 0.3, 0.1, 800)\n    };\n})();\n\n/**\n * GAME ENGINE\n */\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\ncanvas.width = 800;\ncanvas.height = 600;\n\nconst CONFIG = {\n    SHIP_SIZE: 15,\n    SHIP_THRUST: 0.1,\n    SHIP_FRICTION: 0.99,\n    SHIP_ROT_SPEED: 0.07,\n    BULLET_SPEED: 6,\n    BULLET_LIFE: 60,\n    ASTEROID_NUM: 3,\n    ASTEROID_SIZE: 50,\n    ASTEROID_SPEED: 1.5,\n    UFO_CHANCE: 0.2,\n    UFO_SPEED: 2\n};\n\nclass Entity {\n    constructor(x, y, radius) {\n        this.x = x;\n        this.y = y;\n        this.radius = radius;\n        this.vx = 0;\n        this.vy = 0;\n        this.angle = 0;\n        this.markedForDeletion = false;\n    }\n\n    update() {\n        this.x += this.vx;\n        this.y += this.vy;\n\n        if (this.x < -this.radius) this.x = canvas.width + this.radius;\n        else if (this.x > canvas.width + this.radius) this.x = -this.radius;\n        if (this.y < -this.radius) this.y = canvas.height + this.radius;\n        else if (this.y > canvas.height + this.radius) this.y = -this.radius;\n    }\n\n    draw() {\n        ctx.strokeStyle = '#0f0';\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        // To be overridden\n        ctx.stroke();\n    }\n}\n\nclass Ship extends Entity {\n    constructor() {\n        super(canvas.width / 2, canvas.height / 2, CONFIG.SHIP_SIZE);\n        this.vx = 0;\n        this.vy = 0;\n        this.angle = -Math.PI / 2;\n        this.thrusting = false;\n        this.invulnerable = 120; // frames\n    }\n\n    update() {\n        if (this.thrusting) {\n            this.vx += Math.cos(this.angle) * CONFIG.SHIP_THRUST;\n            this.vy += Math.sin(this.angle) * CONFIG.SHIP_THRUST;\n        }\n        this.vx *= CONFIG.SHIP_FRICTION;\n        this.vy *= CONFIG.SHIP_FRICTION;\n        super.update();\n        if (this.invulnerable > 0) this.invulnerable--;\n    }\n\n    draw() {\n        if (this.invulnerable % 10 > 5) return; // Blink effect\n        ctx.strokeStyle = '#0f0';\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.moveTo(\n            this.x + Math.cos(this.angle) * this.radius,\n            this.y + Math.sin(this.angle) * this.radius\n        );\n        ctx.lineTo(\n            this.x + Math.cos(this.angle + 2.5) * this.radius,\n            this.y + Math.sin(this.angle + 2.5) * this.radius\n        );\n        ctx.lineTo(\n            this.x + Math.cos(this.angle - 2.5) * this.radius,\n            this.y + Math.sin(this.angle - 2.5) * this.radius\n        );\n        ctx.closePath();\n        ctx.stroke();\n\n        if (this.thrusting) {\n            ctx.beginPath();\n            ctx.moveTo(\n                this.x + Math.cos(this.angle + Math.PI) * (this.radius * 0.6),\n                this.y + Math.sin(this.angle + Math.PI) * (this.radius * 0.6)\n            );\n            ctx.lineTo(\n                this.x + Math.cos(this.angle + 2.8) * this.radius,\n                this.y + Math.sin(this.angle + 2.8) * this.radius\n            );\n            ctx.lineTo(\n                this.x + Math.cos(this.angle - 2.8) * this.radius,\n                this.y + Math.sin(this.angle - 2.8) * this.radius\n            );\n            ctx.stroke();\n        }\n    }\n\n    jump() {\n        AudioEngine.jump();\n        this.x = Math.random() * canvas.width;\n        this.y = Math.random() * canvas.height;\n    }\n}\n\nclass Asteroid extends Entity {\n    constructor(x, y, radius, level = 3) {\n        super(x, y, radius);\n        this.level = level; // 3: Large, 2: Med, 1: Small\n        const speed = CONFIG.ASTEROID_SPEED * (4 - level);\n        const angle = Math.random() * Math.PI * 2;\n        this.vx = Math.cos(angle) * speed;\n        this.vy = Math.sin(angle) * speed;\n\n        // Randomize shape vertices\n        this.vertices = [];\n        const vertCount = 8 + Math.floor(Math.random() * 7);\n        for (let i = 0; i < vertCount; i++) {\n            const dist = radius * (0.7 + Math.random() * 0.4);\n            const theta = (i / vertCount) * Math.PI * 2;\n            this.vertices.push({ x: Math.cos(theta) * dist, y: Math.sin(theta) * dist });\n        }\n    }\n\n    draw() {\n        ctx.strokeStyle = '#0f0';\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.moveTo(this.x + this.vertices[0].x, this.y + this.vertices[0].y);\n        for (let i = 1; i < this.vertices.length; i++) {\n            ctx.lineTo(this.x + this.vertices[i].x, this.y + this.vertices[i].y);\n        }\n        ctx.closePath();\n        ctx.stroke();\n    }\n}\n\nclass Bullet extends Entity {\n    constructor(x, y, angle) {\n        super(x, y, 2);\n        this.vx = Math.cos(angle) * CONFIG.BULLET_SPEED;\n        this.vy = Math.sin(angle) * CONFIG.BULLET_SPEED;\n        this.life = CONFIG.BULLET_LIFE;\n    }\n\n    update() {\n        super.update();\n        this.life--;\n        if (this.life <= 0) this.markedForDeletion = true;\n    }\n\n    draw() {\n        ctx.fillStyle = '#0f0';\n        ctx.fillRect(this.x - 1, this.y - 1, 3, 3);\n    }\n}\n\nclass UFO extends Entity {\n    constructor() {\n        super(Math.random() > 0.5 ? 0 : canvas.width, Math.random() * canvas.height, 15);\n        this.vx = (this.x === 0) ? CONFIG.UFO_SPEED : -CONFIG.UFO_SPEED;\n        this.vy = (Math.random() - 0.5) * 2;\n        this.shootTimer = 60;\n    }\n\n    update(ship, bullets) {\n        super.update();\n        this.shootTimer--;\n        if (this.shootTimer <= 0) {\n            const angle = Math.atan2(ship.y - this.y, ship.x - this.x);\n            bullets.push(new Bullet(this.x, this.y, angle));\n            this.shootTimer = 100 + Math.random() * 100;\n        }\n    }\n\n    draw() {\n        ctx.strokeStyle = '#0f0';\n        ctx.lineWidth = 2;\n        ctx.beginPath();\n        ctx.ellipse(this.x, this.y, this.radius, this.radius / 3, 0, 0, Math.PI * 2);\n        ctx.stroke();\n        ctx.beginPath();\n        ctx.arc(this.x, this.y - 2, this.radius / 4, 0, Math.PI * 2);\n        ctx.stroke();\n    }\n}\n\nconst game = {\n    score: 0,\n    lives: 3,\n    level: 1,\n    ship: null,\n    asteroids: [],\n    bullets: [],\n    ufo: null,\n    keys: {},\n    running: false,\n\n    init() {\n        window.addEventListener('keydown', e => this.keys[e.code] = true);\n        window.addEventListener('keyup', e => this.keys[e.code] = false);\n        this.updateHighScoreTable();\n    },\n\n    start() {\n        AudioEngine.init();\n        document.getElementById('start-screen').classList.remove('active');\n        document.getElementById('game-over-screen').classList.remove('active');\n        this.score = 0;\n        this.lives = 3;\n        this.level = 1;\n        this.running = true;\n        this.spawnLevel();\n        this.loop();\n    },\n\n    spawnLevel() {\n        this.asteroids = [];\n        this.bullets = [];\n        this.ufo = null;\n        this.ship = new Ship();\n        const count = CONFIG.ASTEROID_NUM + this.level;\n        for (let i = 0; i < count; i++) {\n            let x, y;\n            do {\n                x = Math.random() * canvas.width;\n                y = Math.random() * canvas.height;\n            } while (this.dist(x, y, this.ship.x, this.ship.y) < 150);\n            this.asteroids.push(new Asteroid(x, y, CONFIG.ASTEROID_SIZE, 3));\n        }\n    },\n\n    dist(x1, y1, x2, y2) {\n        return Math.sqrt((x2 - x1)**2 + (y2 - y1)**2);\n    },\n\n    handleInput() {\n        if (!this.ship) return;\n        if (this.keys['ArrowLeft'] || this.keys['KeyA']) this.ship.angle -= CONFIG.SHIP_ROT_SPEED;\n        if (this.keys['ArrowRight'] || this.keys['KeyD']) this.ship.angle += CONFIG.SHIP_ROT_SPEED;\n        if (this.keys['ArrowUp'] || this.keys['KeyW']) {\n            this.ship.thrusting = true;\n            if (Math.random() > 0.8) AudioEngine.thrust();\n        } else {\n            this.ship.thrusting = false;\n        }\n        if (this.keys['Space']) {\n            this.keys['Space'] = false; // Prevent rapid fire\n            this.bullets.push(new Bullet(this.ship.x, this.ship.y, this.ship.angle));\n            AudioEngine.shoot();\n        }\n        if (this.keys['ShiftLeft'] || this.keys['ShiftRight']) {\n            this.keys['ShiftLeft'] = false;\n            this.keys['ShiftRight'] = false;\n            this.ship.jump();\n        }\n    },\n\n    update() {\n        this.handleInput();\n\n        this.ship.update();\n\n        // UFO Logic\n        if (!this.ufo && Math.random() < 0.002) {\n            this.ufo = new UFO();\n            AudioEngine.ufo();\n        }\n        if (this.ufo) {\n            this.ufo.update(this.ship, this.bullets);\n        }\n\n        this.asteroids.forEach(a => a.update());\n        this.bullets.forEach(b => b.update());\n\n        // Collisions: Bullet vs Asteroid\n        this.bullets.forEach(b => {\n            this.asteroids.forEach(a => {\n                if (!b.markedForDeletion && this.dist(b.x, b.y, a.x, a.y) < a.radius) {\n                    b.markedForDeletion = true;\n                    a.markedForDeletion = true;\n                    this.score += (4 - a.level) * 100;\n                    AudioEngine.explode();\n                    if (a.level > 1) {\n                        for (let i = 0; i < 2; i++) {\n                            this.asteroids.push(new Asteroid(a.x, a.y, a.radius / 2, a.level - 1));\n                        }\n                    }\n                }\n            });\n            if (this.ufo && !b.markedForDeletion && this.dist(b.x, b.y, this.ufo.x, this.ufo.y) < this.ufo.radius) {\n                b.markedForDeletion = true;\n                this.ufo.markedForDeletion = true;\n                this.score += 500;\n                AudioEngine.explode();\n            }\n        });\n\n        // Collisions: Ship vs Asteroid/UFO\n        if (this.ship.invulnerable <= 0) {\n            let hit = false;\n            this.asteroids.forEach(a => {\n                if (this.dist(this.ship.x, this.ship.y, a.x, a.y) < a.radius + this.ship.radius * 0.5) {\n                    hit = true;\n                }\n            });\n            if (this.ufo && this.dist(this.ship.x, this.ship.y, this.ufo.x, this.ufo.y) < this.ufo.radius + this.ship.radius) {\n                hit = true;\n            }\n\n            if (hit) {\n                this.lives--;\n                AudioEngine.explode();\n                if (this.lives <= 0) {\n                    this.gameOver();\n                } else {\n                    this.ship = new Ship(); // Reset ship position and give invulnerability\n                }\n            }\n        }\n\n        // Cleanup\n        this.asteroids = this.asteroids.filter(a => !a.markedForDeletion);\n        this.bullets = this.bullets.filter(b => !b.markedForDeletion);\n        if (this.ufo && this.ufo.markedForDeletion) this.ufo = null;\n\n        // Level Up\n        if (this.asteroids.length === 0) {\n            this.level++;\n            this.spawnLevel();\n        }\n\n        // Update HUD\n        document.getElementById('scoreVal').innerText = this.score;\n        document.getElementById('livesVal').innerText = this.lives;\n        document.getElementById('levelVal').innerText = this.level;\n    },\n\n    draw() {\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\n        \n        // Glow effect\n        ctx.shadowBlur = 10;\n        ctx.shadowColor = '#0f0';\n\n        this.ship.draw();\n        this.asteroids.forEach(a => a.draw());\n        this.bullets.forEach(b => b.draw());\n        if (this.ufo) this.ufo.draw();\n\n        ctx.shadowBlur = 0;\n    },\n\n    loop() {\n        if (!this.running) return;\n        this.update();\n        this.draw();\n        requestAnimationFrame(() => this.loop());\n    },\n\n    gameOver() {\n        this.running = false;\n        document.getElementById('game-over-screen').classList.add('active');\n        document.getElementById('finalScore').innerText = this.score;\n        this.saveHighScore();\n        this.updateHighScoreTable();\n    },\n\n    saveHighScore() {\n        try {\n            let scores = JSON.parse(localStorage.getItem('asteroids_scores') || '[]');\n            scores.push(this.score);\n            scores.sort((a, b) => b - a);\n            scores = scores.slice(0, 5);\n            localStorage.setItem('asteroids_scores', JSON.stringify(scores));\n        } catch (e) {\n            console.warn(\"LocalStorage not available\");\n        }\n    },\n\n    updateHighScoreTable() {\n        let scores = [];\n        try {\n            scores = JSON.parse(localStorage.getItem('asteroids_scores') || '[]');\n        } catch (e) {\n            console.warn(\"LocalStorage not available\");\n        }\n        let html = '<strong>TOP PILOTS:</strong><br>';\n        if (scores.length === 0) html += 'No records yet.';\n        scores.forEach((s, i) => {\n            html += `<div class=\"score-row\"><span>#${i+1}</span><span>${s}</span></div>`;\n        });\n        document.getElementById('high-scores').innerHTML = html;\n    }\n};\n\ngame.init();\n</script>\n</body>\n</html>"
}