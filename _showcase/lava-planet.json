 "prompt": "Create a single-page Three.js lava planet with animated emissive cracks, atmosphere shell glow, and orbiting debris. Add configurable rotation speed and glow intensity. Keep materials dramatic and high contrast. Output one self-contained HTML file with inline JavaScript.",
 "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<title>Lava Planet — Molten World</title>\n<style>\n  :root {\n    --bg: #05030a;\n    --fg: #ffe9d6;\n    --muted: #8a7b85;\n    --accent: #ff5a1f;\n    --accent2: #ffb347;\n    --panel: rgba(15, 8, 20, 0.55);\n    --border: rgba(255, 120, 60, 0.25);\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--fg); font-family: 'Inter', system-ui, -apple-system, sans-serif; }\n  canvas { display: block; }\n\n  /* Title */\n  .title {\n    position: fixed; top: 28px; left: 36px; z-index: 10;\n    pointer-events: none; user-select: none;\n  }\n  .title h1 {\n    margin: 0; font-size: 26px; font-weight: 800; letter-spacing: 4px;\n    text-transform: uppercase;\n    background: linear-gradient(90deg, #ff8a3d, #ffd86b);\n    -webkit-background-clip: text; background-clip: text; color: transparent;\n    text-shadow: 0 0 30px rgba(255,90,30,0.4);\n  }\n  .title p { margin: 6px 0 0; font-size: 12px; letter-spacing: 3px; color: var(--muted); text-transform: uppercase; }\n\n  /* Control panel */\n  .panel {\n    position: fixed; top: 24px; right: 24px; z-index: 10;\n    width: 300px;\n    background: var(--panel);\n    border: 1px solid var(--border);\n    border-radius: 16px;\n    backdrop-filter: blur(14px) saturate(140%);\n    -webkit-backdrop-filter: blur(14px) saturate(140%);\n    padding: 22px 22px 18px;\n    box-shadow: 0 20px 60px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.06);\n  }\n  .panel h2 {\n    margin: 0 0 18px; font-size: 11px; letter-spacing: 3px; text-transform: uppercase;\n    color: var(--accent2); font-weight: 700;\n    display: flex; align-items: center; gap: 8px;\n  }\n  .panel h2::before {\n    content: ''; width: 7px; height: 7px; border-radius: 50%;\n    background: var(--accent); box-shadow: 0 0 10px var(--accent);\n  }\n  .ctl { margin-bottom: 16px; }\n  .ctl label {\n    display: flex; justify-content: space-between; align-items: baseline;\n    font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;\n    color: var(--muted); margin-bottom: 8px;\n  }\n  .ctl label span { color: var(--fg); font-weight: 600; font-variant-numeric: tabular-nums; }\n  .ctl input[type=\"range\"] {\n    -webkit-appearance: none; appearance: none;\n    width: 100%; height: 4px; border-radius: 2px;\n    background: linear-gradient(90deg, #ff5a1f, #ffb347);\n    outline: none; cursor: pointer;\n  }\n  .ctl input[type=\"range\"]::-webkit-slider-thumb {\n    -webkit-appearance: none; appearance: none;\n    width: 16px; height: 16px; border-radius: 50%;\n    background: #fff; cursor: grab;\n    box-shadow: 0 0 0 4px rgba(255,90,30,0.25), 0 0 12px rgba(255,180,80,0.6);\n    transition: transform 0.15s;\n  }\n  .ctl input[type=\"range\"]::-webkit-slider-thumb:hover { transform: scale(1.15); }\n  .ctl input[type=\"range\"]::-moz-range-thumb {\n    width: 16px; height: 16px; border-radius: 50%; border: none;\n    background: #fff; cursor: grab;\n    box-shadow: 0 0 0 4px rgba(255,90,30,0.25), 0 0 12px rgba(255,180,80,0.6);\n  }\n  .btn-row { display: flex; gap: 10px; margin-top: 6px; }\n  .btn {\n    flex: 1; padding: 10px 12px; border-radius: 10px;\n    background: rgba(255,90,30,0.12); border: 1px solid var(--border);\n    color: var(--fg); font-size: 11px; letter-spacing: 2px;\n    text-transform: uppercase; font-weight: 600; cursor: pointer;\n    transition: all 0.2s;\n  }\n  .btn:hover { background: rgba(255,90,30,0.25); transform: translateY(-1px); }\n  .btn.active { background: var(--accent); color: #1a0805; border-color: var(--accent); }\n\n  /* Footer */\n  .foot {\n    position: fixed; bottom: 22px; left: 36px; z-index: 10;\n    font-size: 11px; letter-spacing: 2px; color: var(--muted); text-transform: uppercase;\n    pointer-events: none;\n  }\n  .foot b { color: var(--accent2); font-weight: 600; }\n\n  /* Loading */\n  .loader {\n    position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center;\n    background: #05030a; transition: opacity 0.6s;\n  }\n  .loader.hide { opacity: 0; pointer-events: none; }\n  .loader .ring {\n    width: 48px; height: 48px; border-radius: 50%;\n    border: 2px solid rgba(255,90,30,0.2);\n    border-top-color: var(--accent);\n    animation: spin 1s linear infinite;\n  }\n  @keyframes spin { to { transform: rotate(360deg); } }\n\n  /* Vignette */\n  .vignette {\n    position: fixed; inset: 0; pointer-events: none; z-index: 5;\n    background: radial-gradient(ellipse at center, transparent 50%, rgba(0,0,0,0.6) 100%);\n  }\n</style>\n</head>\n<body>\n  <div class=\"loader\" id=\"loader\"><div class=\"ring\"></div></div>\n\n  <div class=\"title\">\n    <h1>Pyrosphere</h1>\n    <p>Molten World · Live Simulation</p>\n  </div>\n\n  <div class=\"panel\">\n    <h2>Planetary Controls</h2>\n    <div class=\"ctl\">\n      <label>Rotation Speed <span id=\"rotVal\">1.00×</span></label>\n      <input type=\"range\" id=\"rotSpeed\" min=\"0\" max=\"3\" step=\"0.01\" value=\"1\" />\n    </div>\n    <div class=\"ctl\">\n      <label>Glow Intensity <span id=\"glowVal\">1.20</span></label>\n      <input type=\"range\" id=\"glowIntensity\" min=\"0\" max=\"3\" step=\"0.01\" value=\"1.2\" />\n    </div>\n    <div class=\"ctl\">\n      <label>Crack Brightness <span id=\"crkVal\">1.50</span></label>\n      <input type=\"range\" id=\"crackIntensity\" min=\"0\" max=\"3\" step=\"0.01\" value=\"1.5\" />\n    </div>\n    <div class=\"ctl\">\n      <label>Atmosphere Bloom <span id=\"atmVal\">1.00</span></label>\n      <input type=\"range\" id=\"atmIntensity\" min=\"0\" max=\"3\" step=\"0.01\" value=\"1\" />\n    </div>\n    <div class=\"btn-row\">\n      <button class=\"btn\" id=\"pauseBtn\">Pause</button>\n      <button class=\"btn\" id=\"resetBtn\">Reset View</button>\n    </div>\n  </div>\n\n  <div class=\"foot\">Drag to orbit · Scroll to zoom · <b>Auto-rotate</b> enabled</div>\n  <div class=\"vignette\"></div>\n\n  <script type=\"importmap\">\n  {\n    \"imports\": {\n      \"three\": \"https://unpkg.com/three@0.160.0/build/three.module.js\",\n      \"three/addons/\": \"https://unpkg.com/three@0.160.0/examples/jsm/\"\n    }\n  }\n  </script>\n\n  <script type=\"module\">\n    import * as THREE from 'three';\n    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n    import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';\n    import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';\n    import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';\n    import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';\n\n    // ---------- Scene setup ----------\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(0x05030a);\n    scene.fog = new THREE.FogExp2(0x05030a, 0.012);\n\n    const camera = new THREE.PerspectiveCamera(50, window.innerWidth/window.innerHeight, 0.1, 200);\n    camera.position.set(0, 1.2, 7);\n\n    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\n    renderer.toneMapping = THREE.ACESFilmicToneMapping;\n    renderer.toneMappingExposure = 1.1;\n    renderer.outputColorSpace = THREE.SRGBColorSpace;\n    document.body.appendChild(renderer.domElement);\n\n    // ---------- Controls ----------\n    const controls = new OrbitControls(camera, renderer.domElement);\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.06;\n    controls.minDistance = 4;\n    controls.maxDistance = 20;\n    controls.autoRotate = true;\n    controls.autoRotateSpeed = 0.4;\n\n    // ---------- Lighting ----------\n    const ambient = new THREE.AmbientLight(0x221018, 0.4);\n    scene.add(ambient);\n    const sun = new THREE.DirectionalLight(0xff8848, 1.4);\n    sun.position.set(-5, 3, -4);\n    scene.add(sun);\n    const rim = new THREE.DirectionalLight(0x6688ff, 0.4);\n    rim.position.set(6, -2, 5);\n    scene.add(rim);\n\n    // ---------- Planet ----------\n    const planetGroup = new THREE.Group();\n    scene.add(planetGroup);\n\n    // Procedural noise functions (in shader)\n    const planetMat = new THREE.ShaderMaterial({\n      uniforms: {\n        uTime: { value: 0 },\n        uCrackIntensity: { value: 1.5 },\n        uGlowIntensity: { value: 1.2 },\n      },\n      vertexShader: `\n        varying vec3 vNormal;\n        varying vec3 vWorldNormal;\n        varying vec3 vPos;\n        varying vec3 vViewDir;\n        void main() {\n          vNormal = normal;\n          vWorldNormal = normalize(mat3(modelMatrix) * normal);\n          vPos = position;\n          vec4 mv = modelViewMatrix * vec4(position, 1.0);\n          vViewDir = normalize(-mv.xyz);\n          gl_Position = projectionMatrix * mv;\n        }\n      `,\n      fragmentShader: `\n        uniform float uTime;\n        uniform float uCrackIntensity;\n        uniform float uGlowIntensity;\n        varying vec3 vNormal;\n        varying vec3 vWorldNormal;\n        varying vec3 vPos;\n        varying vec3 vViewDir;\n\n        // 3D simplex-ish noise (cheap hash based)\n        float hash(vec3 p) {\n          p = fract(p * 0.3183099 + 0.1);\n          p *= 17.0;\n          return fract(p.x * p.y * p.z * (p.x + p.y + p.z));\n        }\n        float noise(vec3 x) {\n          vec3 p = floor(x);\n          vec3 f = fract(x);\n          f = f*f*(3.0-2.0*f);\n          return mix(\n            mix(\n              mix(hash(p+vec3(0.0,0.0,0.0)), hash(p+vec3(1.0,0.0,0.0)), f.x),\n              mix(hash(p+vec3(0.0,1.0,0.0)), hash(p+vec3(1.0,1.0,0.0)), f.x),\n              f.y\n            ),\n            mix(\n              mix(hash(p+vec3(0.0,0.0,1.0)), hash(p+vec3(1.0,0.0,1.0)), f.x),\n              mix(hash(p+vec3(0.0,1.0,1.0)), hash(p+vec3(1.0,1.0,1.0)), f.x),\n              f.y\n            ),\n            f.z\n          );\n        }\n        float fbm(vec3 p) {\n          float v = 0.0; float a = 0.5;\n          for(int i=0;i<6;i++){ v += a*noise(p); p *= 2.0; a *= 0.5; }\n          return v;\n        }\n\n        void main() {\n          vec3 p = normalize(vPos) * 2.0;\n\n          // Continent / rock layer\n          float rock = fbm(p * 1.5);\n          float ridge = fbm(p * 3.0 + vec3(10.0));\n\n          // Crack pattern: ridged noise -> sharp veins\n          float crack = 1.0 - abs(fbm(p * 2.2 + vec3(uTime*0.02)) - 0.5) * 2.0;\n          crack = pow(crack, 6.0);\n          float fineCrack = 1.0 - abs(noise(p * 8.0 + uTime*0.05) - 0.5) * 2.0;\n          fineCrack = pow(fineCrack, 8.0);\n          crack = max(crack, fineCrack * 0.5);\n\n          // Pulsing lava\n          float pulse = 0.6 + 0.4 * sin(uTime * 1.2 + fbm(p*2.0)*6.0);\n          vec3 lavaHot = mix(vec3(0.35, 0.02, 0.0), vec3(1.0, 0.35, 0.05), pulse);\n          vec3 lavaBright = mix(lavaHot, vec3(1.6, 1.0, 0.4), pow(crack, 1.5) * pulse);\n\n          // Rock base color (charred)\n          float rockShade = smoothstep(0.2, 0.8, rock);\n          vec3 darkRock = mix(vec3(0.04, 0.02, 0.03), vec3(0.18, 0.08, 0.06), rockShade);\n          darkRock += vec3(0.06, 0.02, 0.0) * ridge;\n\n          // Mix rock with lava by crack intensity\n          float lavaMask = crack * uCrackIntensity;\n          lavaMask = clamp(lavaMask, 0.0, 1.0);\n          vec3 surface = mix(darkRock, lavaBright, lavaMask);\n\n          // Fresnel for darkening edges (silhouette glow handled by atmosphere)\n          float fres = pow(1.0 - max(dot(vNormal, vViewDir), 0.0), 2.0);\n          surface += lavaBright * fres * 0.3 * uGlowIntensity;\n\n          // Emissive boost on lava areas\n          vec3 emissive = lavaBright * lavaMask * (1.5 * uGlowIntensity);\n\n          vec3 col = surface + emissive * 0.4;\n\n          // Slight rim warmth\n          col += vec3(1.0, 0.3, 0.1) * fres * 0.15 * uGlowIntensity;\n\n          gl_FragColor = vec4(col, 1.0);\n        }\n      `,\n    });\n\n    const planetGeo = new THREE.IcosahedronGeometry(1.5, 64);\n    const planet = new THREE.Mesh(planetGeo, planetMat);\n    planetGroup.add(planet);\n\n    // ---------- Atmosphere shell ----------\n    const atmMat = new THREE.ShaderMaterial({\n      uniforms: {\n        uIntensity: { value: 1.0 },\n        uColor: { value: new THREE.Color(0xff5a1f) },\n        uColor2: { value: new THREE.Color(0xffb347) },\n      },\n      vertexShader: `\n        varying vec3 vNormal;\n        varying vec3 vViewDir;\n        void main() {\n          vNormal = normalize(normalMatrix * normal);\n          vec4 mv = modelViewMatrix * vec4(position, 1.0);\n          vViewDir = normalize(-mv.xyz);\n          gl_Position = projectionMatrix * mv;\n        }\n      `,\n      fragmentShader: `\n        uniform float uIntensity;\n        uniform vec3 uColor;\n        uniform vec3 uColor2;\n        varying vec3 vNormal;\n        varying vec3 vViewDir;\n        void main() {\n          float fres = 1.0 - max(dot(vNormal, vViewDir), 0.0);\n          float glow = pow(fres, 3.0) * uIntensity;\n          vec3 col = mix(uColor, uColor2, pow(fres, 2.0));\n          gl_FragColor = vec4(col * glow, glow);\n        }\n      `,\n      transparent: true,\n      blending: THREE.AdditiveBlending,\n      side: THREE.BackSide,\n      depthWrite: false,\n    });\n    const atm = new THREE.Mesh(new THREE.IcosahedronGeometry(1.72, 48), atmMat);\n    planetGroup.add(atm);\n\n    // Inner glow (front side, slight)\n    const innerGlowMat = new THREE.ShaderMaterial({\n      uniforms: { uIntensity: { value: 1.0 } },\n      vertexShader: `\n        varying vec3 vNormal; varying vec3 vViewDir;\n        void main(){\n          vNormal = normalize(normalMatrix * normal);\n          vec4 mv = modelViewMatrix * vec4(position,1.0);\n          vViewDir = normalize(-mv.xyz);\n          gl_Position = projectionMatrix * mv;\n        }`,\n      fragmentShader: `\n        uniform float uIntensity;\n        varying vec3 vNormal; varying vec3 vViewDir;\n        void main(){\n          float fres = 1.0 - max(dot(vNormal, vViewDir), 0.0);\n          float g = pow(fres, 4.0) * 0.6 * uIntensity;\n          gl_FragColor = vec4(vec3(1.0,0.35,0.1)*g, g);\n        }`,\n      transparent: true, blending: THREE.AdditiveBlending, depthWrite: false,\n    });\n    const innerGlow = new THREE.Mesh(new THREE.IcosahedronGeometry(1.52, 48), innerGlowMat);\n    planetGroup.add(innerGlow);\n\n    // ---------- Orbiting debris ring ----------\n    const debrisGroup = new THREE.Group();\n    scene.add(debrisGroup);\n    // Tilt the ring\n    debrisGroup.rotation.x = 0.35;\n    debrisGroup.rotation.z = 0.12;\n\n    const debrisCount = 320;\n    const debrisGeo = new THREE.IcosahedronGeometry(1, 0);\n    const debrisMat = new THREE.MeshStandardMaterial({\n      color: 0x2a1410,\n      emissive: 0xff4010,\n      emissiveIntensity: 0.6,\n      roughness: 0.85,\n      metalness: 0.1,\n      flatShading: true,\n    });\n\n    const debris = [];\n    const innerR = 2.4, outerR = 3.6;\n    for (let i = 0; i < debrisCount; i++) {\n      const t = Math.random();\n      const r = innerR + (outerR - innerR) * Math.pow(t, 0.6);\n      const angle = Math.random() * Math.PI * 2;\n      const yJitter = (Math.random() - 0.5) * 0.25 * (1 - t);\n\n      const scale = 0.015 + Math.random() * 0.06 * (1 - t * 0.5);\n      const mesh = new THREE.Mesh(debrisGeo, debrisMat);\n      mesh.scale.setScalar(scale);\n      mesh.position.set(Math.cos(angle) * r, yJitter, Math.sin(angle) * r);\n      mesh.rotation.set(Math.random()*Math.PI, Math.random()*Math.PI, Math.random()*Math.PI);\n\n      mesh.userData = {\n        r, angle, yJitter,\n        speed: 0.15 + (0.25 / r) * (0.7 + Math.random()*0.6),\n        spin: (Math.random()-0.5)*2,\n        spinAxis: new THREE.Vector3(Math.random()-0.5, Math.random()-0.5, Math.random()-0.5).normalize(),\n        emissiveBoost: Math.random() < 0.25,\n      };\n      debrisGroup.add(mesh);\n      debris.push(mesh);\n    }\n\n    // Small glowing embers drifting\n    const emberCount = 80;\n    const emberGeo = new THREE.SphereGeometry(0.02, 6, 6);\n    const emberMat = new THREE.MeshBasicMaterial({ color: 0xffb060, transparent: true, opacity: 0.9 });\n    const embers = [];\n    for (let i = 0; i < emberCount; i++) {\n      const r = 1.9 + Math.random() * 2.5;\n      const a = Math.random() * Math.PI * 2;\n      const yj = (Math.random()-0.5) * 2.5;\n      const m = new THREE.Mesh(emberGeo, emberMat);\n      m.position.set(Math.cos(a)*r, yj, Math.sin(a)*r);\n      m.userData = { r, a, yj, speed: 0.1 + Math.random()*0.3, drift: Math.random()*Math.PI*2, size: 0.5 + Math.random()*1.5 };\n      m.scale.setScalar(m.userData.size);\n      scene.add(m);\n      embers.push(m);\n    }\n\n    // ---------- Starfield ----------\n    const starGeo = new THREE.BufferGeometry();\n    const starCount = 1200;\n    const starPos = new Float32Array(starCount * 3);\n    const starCol = new Float32Array(starCount * 3);\n    for (let i = 0; i < starCount; i++) {\n      const r = 40 + Math.random()*40;\n      const th = Math.random()*Math.PI*2;\n      const ph = Math.acos(2*Math.random()-1);\n      starPos[i*3]   = r*Math.sin(ph)*Math.cos(th);\n      starPos[i*3+1] = r*Math.sin(ph)*Math.sin(th);\n      starPos[i*3+2] = r*Math.cos(ph);\n      const warm = Math.random();\n      starCol[i*3]   = 0.8 + warm*0.2;\n      starCol[i*3+1] = 0.7 + warm*0.3;\n      starCol[i*3+2] = 0.6 + (1-warm)*0.4;\n    }\n    starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));\n    starGeo.setAttribute('color', new THREE.BufferAttribute(starCol, 3));\n    const starMat = new THREE.PointsMaterial({ size: 0.12, sizeAttenuation: true, vertexColors: true, transparent: true, opacity: 0.85 });\n    const stars = new THREE.Points(starGeo, starMat);\n    scene.add(stars);\n\n    // ---------- Post-processing ----------\n    const composer = new EffectComposer(renderer);\n    composer.addPass(new RenderPass(scene, camera));\n    const bloom = new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 0.9, 0.7, 0.2);\n    composer.addPass(bloom);\n    composer.addPass(new OutputPass());\n\n    // ---------- Controls UI ----------\n    const rotSpeedEl = document.getElementById('rotSpeed');\n    const glowEl = document.getElementById('glowIntensity');\n    const crackEl = document.getElementById('crackIntensity');\n    const atmEl = document.getElementById('atmIntensity');\n    const rotVal = document.getElementById('rotVal');\n    const glowVal = document.getElementById('glowVal');\n    const crkVal = document.getElementById('crkVal');\n    const atmVal = document.getElementById('atmVal');\n\n    let rotationSpeed = 1.0;\n    let paused = false;\n\n    rotSpeedEl.addEventListener('input', e => {\n      rotationSpeed = parseFloat(e.target.value);\n      rotVal.textContent = rotationSpeed.toFixed(2) + '×';\n      controls.autoRotate = rotationSpeed > 0.01;\n      controls.autoRotateSpeed = 0.4 * rotationSpeed;\n    });\n    glowEl.addEventListener('input', e => {\n      const v = parseFloat(e.target.value);\n      glowVal.textContent = v.toFixed(2);\n      planetMat.uniforms.uGlowIntensity.value = v;\n      bloom.strength = 0.5 + v * 0.5;\n    });\n    crackEl.addEventListener('input', e => {\n      const v = parseFloat(e.target.value);\n      crkVal.textContent = v.toFixed(2);\n      planetMat.uniforms.uCrackIntensity.value = v;\n    });\n    atmEl.addEventListener('input', e => {\n      const v = parseFloat(e.target.value);\n      atmVal.textContent = v.toFixed(2);\n      atmMat.uniforms.uIntensity.value = v;\n      innerGlowMat.uniforms.uIntensity.value = v;\n    });\n\n    const pauseBtn = document.getElementById('pauseBtn');\n    const resetBtn = document.getElementById('resetBtn');\n    pauseBtn.addEventListener('click', () => {\n      paused = !paused;\n      pauseBtn.textContent = paused ? 'Resume' : 'Pause';\n      pauseBtn.classList.toggle('active', paused);\n    });\n    resetBtn.addEventListener('click', () => {\n      controls.reset();\n      camera.position.set(0, 1.2, 7);\n      controls.update();\n    });\n\n    // ---------- Resize ----------\n    window.addEventListener('resize', () => {\n      camera.aspect = window.innerWidth / window.innerHeight;\n      camera.updateProjectionMatrix();\n      renderer.setSize(window.innerWidth, window.innerHeight);\n      composer.setSize(window.innerWidth, window.innerHeight);\n    });\n\n    // ---------- Animation loop ----------\n    const clock = new THREE.Clock();\n    function animate() {\n      requestAnimationFrame(animate);\n      const dt = clock.getDelta();\n      const t = clock.elapsedTime;\n\n      if (!paused) {\n        planetMat.uniforms.uTime.value = t;\n        planet.rotation.y += dt * 0.05 * rotationSpeed;\n\n        // Debris orbit\n        debris.forEach(d => {\n          const u = d.userData;\n          u.angle += dt * u.speed * rotationSpeed;\n          d.position.x = Math.cos(u.angle) * u.r;\n          d.position.z = Math.sin(u.angle) * u.r;\n          d.position.y = u.yJitter + Math.sin(t * u.speed * 2 + u.r) * 0.03;\n          d.rotateOnAxis(u.spinAxis, dt * u.spin * rotationSpeed);\n          if (u.emissiveBoost) {\n            d.material.emissiveIntensity = 0.4 + 0.5 * Math.sin(t * 2 + u.r * 10);\n          }\n        });\n\n        // Embers drift\n        embers.forEach(m => {\n          m.userData.a += dt * m.userData.speed * rotationSpeed;\n          const r = m.userData.r;\n          m.position.x = Math.cos(m.userData.a) * r;\n          m.position.z = Math.sin(m.userData.a) * r;\n          m.position.y = m.userData.yj + Math.sin(t * 0.5 + m.userData.drift) * 0.4;\n          const flick = 0.6 + 0.4 * Math.sin(t * 4 + m.userData.drift * 3);\n          m.material.opacity = 0.5 + flick * 0.5;\n          m.scale.setScalar(m.userData.size * (0.7 + flick * 0.5));\n        });\n\n        stars.rotation.y += dt * 0.005;\n      }\n\n      controls.update();\n      composer.render();\n    }\n\n    // Hide loader and start\n    setTimeout(() => {\n      document.getElementById('loader').classList.add('hide');\n      animate();\n    }, 300);\n  </script>\n</body>\n</html>"
}