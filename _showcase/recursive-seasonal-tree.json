 "kind": "html",
 "prompt": "Create a single-page p5.js sketch of a recursive fractal tree that cycles through the four seasons: spring buds, lush summer leaves, autumn colours with falling leaves, and a bare winter tree with falling snow. Branches should sway gently in the wind. Include sliders for branch angle and recursion depth, a season speed control, and click-to-regrow a new randomized tree. Render at least 8 levels of recursion smoothly.",
 "code": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Recursive Seasonal Tree</title><style>html,body{margin:0;height:100%;overflow:hidden;background:#10180f;color:#f8fff2;font-family:Inter,system-ui,sans-serif}.panel{position:fixed;left:16px;top:16px;width:300px;padding:12px;border:1px solid rgba(190,230,130,.28);border-radius:8px;background:rgba(18,30,16,.78);box-shadow:0 0 28px rgba(170,230,90,.13);backdrop-filter:blur(10px)}h1{font-size:18px;margin:0 0 8px}.row{display:grid;grid-template-columns:80px 1fr;gap:8px;margin:8px 0;align-items:center;color:#d9e9c8;font-size:12px}button,input{width:100%;border:1px solid rgba(190,230,130,.28);border-radius:6px;background:#25351a;color:white;padding:8px}</style></head><body><div class=\"panel\"><h1>Recursive Seasonal Tree</h1><div class=\"row\"><span>Angle</span><input id=\"ang\" type=\"range\" min=\".25\" max=\".85\" step=\".01\" value=\".48\"></div><div class=\"row\"><span>Depth</span><input id=\"dep\" type=\"range\" min=\"6\" max=\"10\" value=\"8\"></div><div class=\"row\"><span>Season</span><input id=\"spd\" type=\"range\" min=\".02\" max=\".35\" step=\".01\" value=\".09\"></div><button id=\"regrow\">Regrow Tree</button></div><script src=\"https://cdn.jsdelivr.net/npm/p5@1.9.2/lib/p5.min.js\"></script><script>\nlet seed=7,leaves=[],flakes=[];function setup(){createCanvas(windowWidth,windowHeight);pixelDensity(Math.min(devicePixelRatio,2));regrow();document.getElementById('regrow').onclick=regrow}function regrow(){seed=random(99999);leaves=[];flakes=[];for(let i=0;i<180;i++){leaves.push({x:random(width),y:random(-height,height),s:random(.6,1.8),r:random(TAU)});flakes.push({x:random(width),y:random(-height,0),s:random(1,3)})}}function draw(){randomSeed(seed);let season=(millis()/1000*+document.getElementById('spd').value)%4;let skies=['#dff7ff','#bceaff','#ffd7a5','#1b2536'];background(skies[floor(season)]);drawGround(season);push();translate(width/2,height*.91);branch(height*.2,+document.getElementById('dep').value,0,season);pop();weather(season);fill(20,30,25,180);noStroke();textSize(14);text(['spring','summer','autumn','winter'][floor(season)],width-92,32)}function drawGround(s){noStroke();fill(s<1?'#91d886':s<2?'#56a75c':s<3?'#ba7a35':'#e8eef5');rect(0,height*.9,width,height*.1)}function branch(len,depth,side,season){stroke(92,55,32);strokeWeight(max(1,len*.055));line(0,0,0,-len);translate(0,-len);if(depth>0){let a=+document.getElementById('ang').value,wind=sin(millis()*.0015+depth)*.04;push();rotate(a+wind+random(-.08,.08));branch(len*random(.66,.76),depth-1,1,season);pop();push();rotate(-a+wind+random(-.08,.08));branch(len*random(.64,.75),depth-1,-1,season);pop();if(random()<.38){push();rotate(random(-.35,.35)+wind);branch(len*random(.42,.58),depth-1,0,season);pop()}}else{noStroke();if(season<1)fill('#ff91c8');else if(season<2)fill('#52c45d');else if(season<3)fill(random(['#d95f26','#f2a541','#b7432c']));else fill(235,245,255,130);ellipse(0,0,7,10)}}function weather(season){if(season>=2&&season<3){for(const l of leaves){fill(random(['#d95f26aa','#f2a541aa','#b7432caa']));noStroke();ellipse(l.x,l.y,8*l.s,4*l.s);l.y+=1.1*l.s;l.x+=sin(l.y*.02)*.7;if(l.y>height)l.y=random(-80,-10)}}if(season>=3){for(const f of flakes){fill(255,255,255,190);noStroke();circle(f.x,f.y,f.s);f.y+=f.s*.7;f.x+=sin(f.y*.04)*.5;if(f.y>height)f.y=random(-100,-10)}}}function mousePressed(){regrow()}function windowResized(){resizeCanvas(windowWidth,windowHeight);regrow()}</script></body></html>"
}