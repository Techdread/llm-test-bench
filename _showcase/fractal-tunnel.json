 "prompt": "Create a single-page Three.js abstract fractal tunnel ride with repeated geometric segments, color pulses, and forward camera travel. Add controls for speed, palette, and pulse frequency. Ensure the animation loops smoothly. Output one self-contained HTML file with inline JavaScript.",
 "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Fractal Pulse Tunnel</title>\n<style>\n  :root {\n    --bg: #05060d;\n    --panel: rgba(12, 15, 30, .72);\n    --line: rgba(255,255,255,.12);\n    --text: #edf1ff;\n    --muted: #8991b4;\n    --accent: #78f7ff;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: var(--bg); color: var(--text); font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }\n  #scene { position: fixed; inset: 0; }\n  .hud {\n    position: fixed;\n    z-index: 2;\n    top: 24px;\n    left: 24px;\n    width: min(320px, calc(100vw - 48px));\n    padding: 20px;\n    border: 1px solid var(--line);\n    border-radius: 20px;\n    background: linear-gradient(145deg, rgba(21, 25, 48, .82), rgba(8, 10, 22, .58));\n    box-shadow: 0 20px 70px rgba(0,0,0,.35), inset 0 1px rgba(255,255,255,.08);\n    backdrop-filter: blur(18px);\n  }\n  .eyebrow {\n    color: var(--accent);\n    font-size: 10px;\n    letter-spacing: .22em;\n    text-transform: uppercase;\n    font-weight: 800;\n    margin-bottom: 8px;\n  }\n  h1 { margin: 0; font-size: 25px; letter-spacing: -.04em; line-height: 1; }\n  .sub { margin: 9px 0 21px; color: var(--muted); font-size: 12px; line-height: 1.5; }\n  .control { margin: 17px 0; }\n  .label-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 9px; font-size: 12px; color: #c8cde2; }\n  output { color: var(--accent); font-variant-numeric: tabular-nums; }\n  input[type=\"range\"] { width: 100%; height: 4px; appearance: none; border-radius: 10px; background: rgba(255,255,255,.15); outline: none; }\n  input[type=\"range\"]::-webkit-slider-thumb { appearance: none; width: 15px; height: 15px; border-radius: 50%; background: var(--accent); border: 3px solid #162338; box-shadow: 0 0 15px var(--accent); cursor: pointer; }\n  select {\n    width: 100%; color: var(--text); background: rgba(255,255,255,.08); border: 1px solid var(--line);\n    border-radius: 10px; padding: 10px 11px; outline: none; font: inherit; font-size: 12px;\n  }\n  .footer { border-top: 1px solid var(--line); padding-top: 14px; margin-top: 18px; display:flex; justify-content:space-between; color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: .12em; }\n  .hint { position: fixed; bottom: 20px; right: 24px; color: rgba(220,225,255,.55); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; pointer-events: none; }\n  @media (max-width: 600px) { .hud { top: 14px; left: 14px; padding: 16px; } .hint { display:none; } }\n</style>\n</head>\n<body>\n<div id=\"scene\"></div>\n<section class=\"hud\">\n  <div class=\"eyebrow\">Generative motion study</div>\n  <h1>Fractal Pulse</h1>\n  <p class=\"sub\">A continuously folding geometric passage. Move your pointer to bend the vanishing point.</p>\n  <div class=\"control\">\n    <div class=\"label-row\"><span>Travel speed</span><output id=\"speedValue\">1.00×</output></div>\n    <input id=\"speed\" type=\"range\" min=\".15\" max=\"2.5\" step=\".01\" value=\"1\">\n  </div>\n  <div class=\"control\">\n    <div class=\"label-row\"><span>Pulse frequency</span><output id=\"pulseValue\">1.20 Hz</output></div>\n    <input id=\"pulse\" type=\"range\" min=\".2\" max=\"4\" step=\".01\" value=\"1.2\">\n  </div>\n  <div class=\"control\">\n    <div class=\"label-row\"><span>Chromatic field</span></div>\n    <select id=\"palette\">\n      <option value=\"aurora\">Aurora Glass</option>\n      <option value=\"plasma\">Plasma Bloom</option>\n      <option value=\"deep\">Deep Signal</option>\n      <option value=\"candy\">Ultraviolet Candy</option>\n    </select>\n  </div>\n  <div class=\"footer\"><span>Loop ∞</span><span id=\"fps\">60 FPS</span></div>\n</section>\n<div class=\"hint\">Pointer · steer field</div>\n\n<script type=\"module\">\nimport * as THREE from \"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\";\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x05060d);\nscene.fog = new THREE.FogExp2(0x05060d, 0.0085);\n\nconst camera = new THREE.PerspectiveCamera(70, innerWidth / innerHeight, .1, 260);\ncamera.position.set(0, 0, 0);\ncamera.rotation.order = \"YXZ\";\n\nconst renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });\nrenderer.setPixelRatio(Math.min(devicePixelRatio, 2));\nrenderer.setSize(innerWidth, innerHeight);\nrenderer.outputColorSpace = THREE.SRGBColorSpace;\nrenderer.toneMapping = THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure = 1.25;\ndocument.getElementById(\"scene\").appendChild(renderer.domElement);\n\nconst palettes = {\n  aurora: [0.49, 0.57, 0.78, 0.86],\n  plasma: [0.91, 0.99, 0.07, 0.78],\n  deep: [0.62, 0.70, 0.53, 0.96],\n  candy: [0.82, 0.93, 0.72, 0.03]\n};\n\nconst tunnel = new THREE.Group();\nscene.add(tunnel);\nconst materials = [];\nconst segments = [];\nconst segmentCount = 34;\nconst spacing = 5.15;\nconst tunnelLength = segmentCount * spacing;\n\nfunction material(kind, slot) {\n  const m = kind === \"line\"\n    ? new THREE.LineBasicMaterial({ transparent: true, blending: THREE.AdditiveBlending, depthWrite: false })\n    : new THREE.MeshBasicMaterial({ transparent: true, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide });\n  m.userData.slot = slot;\n  m.userData.kind = kind;\n  materials.push(m);\n  return m;\n}\n\nconst torusGeo = new THREE.TorusGeometry(2.55, .026, 8, 72);\nconst boxGeo = new THREE.BoxGeometry(.54, .54, .54);\nconst octaGeo = new THREE.OctahedronGeometry(1.08, 1);\nconst icoGeo = new THREE.IcosahedronGeometry(.42, 1);\nconst coreGeo = new THREE.SphereGeometry(.22, 12, 12);\n\nfor (let i = 0; i < segmentCount; i++) {\n  const g = new THREE.Group();\n  g.position.z = -i * spacing - spacing * .72;\n  g.rotation.z = i * .19;\n  g.userData.index = i;\n\n  const outer = new THREE.Mesh(torusGeo, material(\"mesh\", i % 4));\n  outer.rotation.x = Math.PI / 2;\n  g.add(outer);\n\n  const octa = new THREE.LineSegments(new THREE.EdgesGeometry(octaGeo), material(\"line\", (i + 1) % 4));\n  octa.scale.setScalar(1.7);\n  octa.rotation.set(.3, .2, i * .13);\n  g.add(octa);\n\n  for (let j = 0; j < 8; j++) {\n    const a = j / 8 * Math.PI * 2;\n    const arm = new THREE.Group();\n    arm.position.set(Math.cos(a) * 2.12, Math.sin(a) * 2.12, 0);\n    arm.rotation.z = a + Math.PI / 4;\n    arm.rotation.x = i * .12 + j * .17;\n\n    const cube = new THREE.Mesh(boxGeo, material(\"mesh\", (j + i) % 4));\n    cube.scale.setScalar(.72 + (j % 2) * .28);\n    arm.add(cube);\n\n    const shard = new THREE.LineSegments(new THREE.EdgesGeometry(icoGeo), material(\"line\", (j + i + 2) % 4));\n    shard.scale.setScalar(1.15);\n    shard.rotation.y = j;\n    arm.add(shard);\n\n    const dot = new THREE.Mesh(coreGeo, material(\"mesh\", (j + 2) % 4));\n    dot.position.z = .5;\n    dot.scale.setScalar(.8);\n    arm.add(dot);\n    g.add(arm);\n  }\n  tunnel.add(g);\n  segments.push(g);\n}\n\nconst starsGeo = new THREE.BufferGeometry();\nconst starPositions = [];\nfor (let i = 0; i < 850; i++) {\n  const z = -Math.random() * 190;\n  const angle = Math.random() * Math.PI * 2;\n  const r = 7 + Math.random() * 28;\n  starPositions.push(Math.cos(angle) * r, Math.sin(angle) * r, z);\n}\nstarsGeo.setAttribute(\"position\", new THREE.Float32BufferAttribute(starPositions, 3));\nconst stars = new THREE.Points(starsGeo, new THREE.PointsMaterial({\n  color: 0x9bb8ff, size: .035, transparent: true, opacity: .5, blending: THREE.AdditiveBlending, depthWrite: false\n}));\nscene.add(stars);\n\nconst speedInput = document.getElementById(\"speed\");\nconst pulseInput = document.getElementById(\"pulse\");\nconst paletteInput = document.getElementById(\"palette\");\nconst speedValue = document.getElementById(\"speedValue\");\nconst pulseValue = document.getElementById(\"pulseValue\");\nspeedInput.oninput = () => speedValue.textContent = Number(speedInput.value).toFixed(2) + \"×\";\npulseInput.oninput = () => pulseValue.textContent = Number(pulseInput.value).toFixed(2) + \" Hz\";\n\nlet travel = 0;\nlet last = performance.now();\nlet frames = 0, fpsTime = last;\nconst pointer = { x: 0, y: 0, tx: 0, ty: 0 };\naddEventListener(\"pointermove\", e => {\n  pointer.tx = (e.clientX / innerWidth - .5) * 2;\n  pointer.ty = (e.clientY / innerHeight - .5) * 2;\n});\naddEventListener(\"resize\", () => {\n  camera.aspect = innerWidth / innerHeight;\n  camera.updateProjectionMatrix();\n  renderer.setSize(innerWidth, innerHeight);\n});\n\nfunction animate(now) {\n  requestAnimationFrame(animate);\n  const dt = Math.min((now - last) / 1000, .05);\n  last = now;\n  const speed = Number(speedInput.value);\n  const frequency = Number(pulseInput.value);\n  travel += dt * speed * 7.2;\n  const phase = travel % spacing;\n  const hues = palettes[paletteInput.value];\n\n  pointer.x += (pointer.tx - pointer.x) * .035;\n  pointer.y += (pointer.ty - pointer.y) * .035;\n  camera.position.x = pointer.x * .42;\n  camera.position.y = -pointer.y * .28;\n  camera.rotation.y = -pointer.x * .026;\n  camera.rotation.x = pointer.y * .018 + Math.sin(now * .00023) * .006;\n  camera.position.z = Math.sin(now * .00037) * .06;\n\n  segments.forEach((g, i) => {\n    g.position.z = -((i * spacing + phase + spacing * .72) % tunnelLength);\n    const pulse = (Math.sin(now * .001 * frequency * Math.PI * 2 - i * .48) + 1) / 2;\n    g.rotation.z += dt * (.045 + pulse * .025);\n    g.rotation.x = Math.sin(now * .0004 + i * .21) * .09;\n    g.children.forEach((child, j) => {\n      child.rotation.y += dt * (.12 + j * .012) * (i % 2 ? -1 : 1);\n      if (child.children) child.children.forEach((sub, k) => {\n        sub.rotation.x += dt * (.2 + k * .06);\n        sub.rotation.y -= dt * (.16 + k * .04);\n      });\n    });\n    g.traverse(obj => {\n      if (!obj.material || !obj.material.userData) return;\n      const slot = obj.material.userData.slot;\n      const hue = (hues[slot] + Math.sin(now * .00035 + i * .3) * .012 + 1) % 1;\n      obj.material.color.setHSL(hue, .88, .36 + pulse * .22);\n      obj.material.opacity = obj.material.userData.kind === \"line\" ? .34 + pulse * .5 : .12 + pulse * .28;\n    });\n  });\n\n  stars.rotation.z += dt * .002;\n  renderer.render(scene, camera);\n\n  frames++;\n  if (now - fpsTime > 700) {\n    document.getElementById(\"fps\").textContent = Math.round(frames * 1000 / (now - fpsTime)) + \" FPS\";\n    fpsTime = now; frames = 0;\n  }\n}\nrequestAnimationFrame(animate);\n</script>\n</body>\n</html>"
}