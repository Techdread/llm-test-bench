 "kind": "html",
 "prompt": "Build a full-featured Tetris as a single HTML page in vanilla JavaScript — no libraries. Include the 7 standard tetrominoes with correct colours, SRS-style wall kicks, hold piece, next-piece queue showing 3 pieces, ghost piece, soft and hard drop, line-clear animation, levels that speed up, standard scoring (single/double/triple/tetris with level multiplier), pause, game over with restart, and a localStorage high score. Support both keyboard controls and on-screen buttons for touch.",
 "code": "\n\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\n<title>Neon Tetris</title>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/howler/2.2.4/howler.min.js\"></script>\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');\n\n* { margin: 0; padding: 0; box-sizing: border-box; }\n\nbody {\n  background: #0a0a0f;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  font-family: 'Orbitron', monospace;\n  overflow: hidden;\n}\n\n.phone-frame {\n  width: 380px;\n  height: 780px;\n  background: #1a1a2e;\n  border-radius: 50px;\n  border: 3px solid #333;\n  box-shadow: 0 0 60px rgba(0,255,255,0.15), inset 0 0 30px rgba(0,0,0,0.5), 0 0 120px rgba(138,43,226,0.1);\n  position: relative;\n  overflow: hidden;\n  padding: 12px;\n}\n\n.phone-frame::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 150px;\n  height: 30px;\n  background: #1a1a2e;\n  border-radius: 0 0 20px 20px;\n  z-index: 100;\n  border-bottom: 1px solid #333;\n}\n\n.phone-frame::after {\n  content: '';\n  position: absolute;\n  top: 8px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 8px;\n  height: 8px;\n  background: #222;\n  border-radius: 50%;\n  z-index: 101;\n  box-shadow: 0 0 4px rgba(0,255,255,0.3);\n}\n\n.status-bar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 8px 15px 0;\n  color: #fff;\n  font-size: 11px;\n  font-weight: 700;\n  height: 35px;\n}\n\n.status-bar .time { font-size: 13px; }\n\n.status-icons {\n  display: flex;\n  gap: 5px;\n  align-items: center;\n}\n\n.signal-bars {\n  display: flex;\n  gap: 1px;\n  align-items: flex-end;\n}\n\n.signal-bars span {\n  width: 3px;\n  background: #fff;\n  border-radius: 1px;\n}\n\n.signal-bars span:nth-child(1) { height: 4px; }\n.signal-bars span:nth-child(2) { height: 6px; }\n.signal-bars span:nth-child(3) { height: 8px; }\n.signal-bars span:nth-child(4) { height: 10px; }\n\n.battery {\n  width: 22px;\n  height: 10px;\n  border: 1.5px solid #fff;\n  border-radius: 2px;\n  position: relative;\n  display: flex;\n  align-items: center;\n  padding: 1px;\n}\n\n.battery::after {\n  content: '';\n  position: absolute;\n  right: -4px;\n  width: 2px;\n  height: 5px;\n  background: #fff;\n  border-radius: 0 1px 1px 0;\n}\n\n.battery-fill {\n  width: 75%;\n  height: 100%;\n  background: #0f0;\n  border-radius: 1px;\n}\n\n.game-screen {\n  background: #0d0d1a;\n  border-radius: 20px;\n  margin-top: 5px;\n  height: calc(100% - 55px);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  border: 1px solid rgba(0,255,255,0.1);\n  position: relative;\n}\n\n.game-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px 15px;\n  background: rgba(0,0,0,0.3);\n  border-bottom: 1px solid rgba(0,255,255,0.1);\n}\n\n.game-title {\n  font-size: 16px;\n  font-weight: 900;\n  background: linear-gradient(90deg, #0ff, #f0f, #ff0);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  text-shadow: none;\n  letter-spacing: 2px;\n}\n\n.game-info {\n  display: flex;\n  gap: 12px;\n  font-size: 9px;\n  color: #888;\n}\n\n.game-info div {\n  text-align: center;\n}\n\n.game-info .label {\n  color: #555;\n  font-size: 7px;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n\n.game-info .value {\n  color: #0ff;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.game-body {\n  flex: 1;\n  display: flex;\n  padding: 8px;\n  gap: 8px;\n}\n\n.game-board-container {\n  flex: 1;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  position: relative;\n}\n\n#gameCanvas {\n  border-radius: 4px;\n  box-shadow: 0 0 20px rgba(0,255,255,0.1), inset 0 0 20px rgba(0,0,0,0.5);\n}\n\n.side-panel {\n  width: 85px;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.next-piece-box {\n  background: rgba(0,0,0,0.4);\n  border-radius: 10px;\n  padding: 8px;\n  border: 1px solid rgba(0,255,255,0.1);\n  text-align: center;\n}\n\n.next-piece-box .label {\n  font-size: 7px;\n  color: #555;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  margin-bottom: 5px;\n}\n\n#nextCanvas {\n  display: block;\n  margin: 0 auto;\n}\n\n.controls-hint {\n  font-size: 6px;\n  color: #333;\n  text-align: center;\n  line-height: 1.6;\n  margin-top: auto;\n}\n\n.home-bar {\n  position: absolute;\n  bottom: 8px;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 120px;\n  height: 4px;\n  background: rgba(255,255,255,0.2);\n  border-radius: 2px;\n}\n\n.touch-controls {\n  position: absolute;\n  bottom: 15px;\n  left: 15px;\n  right: 15px;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  pointer-events: none;\n  z-index: 50;\n}\n\n.d-pad {\n  display: grid;\n  grid-template-columns: 45px 45px 45px;\n  grid-template-rows: 45px 45px;\n  gap: 3px;\n}\n\n.d-pad button {\n  background: rgba(0,255,255,0.08);\n  border: 1px solid rgba(0,255,255,0.2);\n  border-radius: 10px;\n  color: rgba(0,255,255,0.5);\n  font-size: 18px;\n  pointer-events: all;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  -webkit-tap-highlight-color: transparent;\n  user-select: none;\n  transition: all 0.1s;\n}\n\n.d-pad button:active {\n  background: rgba(0,255,255,0.25);\n  border-color: rgba(0,255,255,0.5);\n  color: #0ff;\n}\n\n.action-buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  align-items: center;\n}\n\n.action-btn {\n  width: 55px;\n  height: 55px;\n  border-radius: 50%;\n  background: rgba(255,0,255,0.08);\n  border: 1px solid rgba(255,0,255,0.2);\n  color: rgba(255,0,255,0.5);\n  font-size: 10px;\n  font-family: 'Orbitron', monospace;\n  font-weight: 700;\n  pointer-events: all;\n  cursor: pointer;\n  -webkit-tap-highlight-color: transparent;\n  user-select: none;\n  transition: all 0.1s;\n}\n\n.action-btn:active {\n  background: rgba(255,0,255,0.3);\n  border-color: rgba(255,0,255,0.6);\n  color: #f0f;\n}\n\n.action-btn.drop-btn {\n  width: 50px;\n  height: 50px;\n  background: rgba(255,255,0,0.08);\n  border-color: rgba(255,255,0,0.2);\n  color: rgba(255,255,0,0.5);\n}\n\n.action-btn.drop-btn:active {\n  background: rgba(255,255,0,0.3);\n  border-color: rgba(255,255,0,0.6);\n  color: #ff0;\n}\n\n.overlay {\n  position: absolute;\n  top: 0; left: 0; right: 0; bottom: 0;\n  background: rgba(0,0,0,0.85);\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  z-index: 200;\n  border-radius: 20px;\n}\n\n.overlay.hidden { display: none; }\n\n.overlay h1 {\n  font-size: 28px;\n  background: linear-gradient(90deg, #0ff, #f0f);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  margin-bottom: 10px;\n}\n\n.overlay p {\n  color: #888;\n  font-size: 10px;\n  margin-bottom: 20px;\n}\n\n.overlay button {\n  background: linear-gradient(135deg, #0ff, #f0f);\n  border: none;\n  padding: 12px 30px;\n  border-radius: 25px;\n  color: #000;\n  font-family: 'Orbitron', monospace;\n  font-weight: 900;\n  font-size: 12px;\n  cursor: pointer;\n  letter-spacing: 2px;\n  transition: transform 0.2s, box-shadow 0.2s;\n}\n\n.overlay button:hover {\n  transform: scale(1.05);\n  box-shadow: 0 0 30px rgba(0,255,255,0.4);\n}\n\n.final-score {\n  color: #ff0;\n  font-size: 18px;\n  margin-bottom: 5px;\n}\n\n@media (max-height: 800px) {\n  .phone-frame {\n    height: 95vh;\n    width: calc(95vh * 0.487);\n    border-radius: 40px;\n  }\n}\n</style>\n</head>\n<body>\n\n<div class=\"phone-frame\">\n  <div class=\"status-bar\">\n    <div class=\"time\" id=\"clockTime\">9:41</div>\n    <div class=\"status-icons\">\n      <div class=\"signal-bars\">\n        <span></span><span></span><span></span><span></span>\n      </div>\n      <span style=\"font-size:10px;\">5G</span>\n      <div class=\"battery\"><div class=\"battery-fill\"></div></div>\n    </div>\n  </div>\n\n  <div class=\"game-screen\">\n    <div class=\"game-header\">\n      <div class=\"game-title\">NEON TETRIS</div>\n      <div class=\"game-info\">\n        <div><div class=\"label\">Score</div><div class=\"value\" id=\"scoreDisplay\">0</div></div>\n        <div><div class=\"label\">Lines</div><div class=\"value\" id=\"linesDisplay\">0</div></div>\n        <div><div class=\"label\">Level</div><div class=\"value\" id=\"levelDisplay\">1</div></div>\n      </div>\n    </div>\n\n    <div class=\"game-body\">\n      <div class=\"game-board-container\">\n        <canvas id=\"gameCanvas\" width=\"240\" height=\"480\"></canvas>\n      </div>\n      <div class=\"side-panel\">\n        <div class=\"next-piece-box\">\n          <div class=\"label\">Next</div>\n          <canvas id=\"nextCanvas\" width=\"70\" height=\"70\"></canvas>\n        </div>\n        <div class=\"controls-hint\">\n          ← → Move<br>↑ Rotate<br>↓ Soft Drop<br>Space Hard Drop<br>P Pause\n        </div>\n      </div>\n    </div>\n\n    <div class=\"touch-controls\" id=\"touchControls\">\n      <div class=\"d-pad\">\n        <div></div>\n        <button id=\"btnLeft\">◀</button>\n        <div></div>\n        <button id=\"btnDown\">▼</button>\n        <button id=\"btnRotate\">↻</button>\n      </div>\n      <div class=\"action-buttons\">\n        <button class=\"action-btn drop-btn\" id=\"btnDrop\">DROP</button>\n      </div>\n    </div>\n\n    <div class=\"overlay\" id=\"startOverlay\">\n      <h1>NEON TETRIS</h1>\n      <p>Stack blocks. Clear lines. Set records.</p>\n      <button onclick=\"startGame()\">START GAME</button>\n    </div>\n\n    <div class=\"overlay hidden\" id=\"gameOverOverlay\">\n      <h1>GAME OVER</h1>\n      <div class=\"final-score\" id=\"finalScore\">0</div>\n      <p id=\"finalLines\">Lines: 0</p>\n      <button onclick=\"startGame()\">PLAY AGAIN</button>\n    </div>\n\n    <div class=\"overlay hidden\" id=\"pauseOverlay\">\n      <h1>PAUSED</h1>\n      <p>Press P or tap to resume</p>\n      <button onclick=\"togglePause()\">RESUME</button>\n    </div>\n  </div>\n\n  <div class=\"home-bar\"></div>\n</div>\n\n<script>\nconst canvas = document.getElementById('gameCanvas');\nconst ctx = canvas.getContext('2d');\nconst nextCanvas = document.getElementById('nextCanvas');\nconst nextCtx = nextCanvas.getContext('2d');\n\nconst COLS = 10;\nconst ROWS = 20;\nconst BLOCK = 24;\nconst NEXT_BLOCK = 16;\n\nconst COLORS = {\n  I: '#00ffff',\n  O: '#ffff00',\n  T: '#ff00ff',\n  S: '#00ff00',\n  Z: '#ff3333',\n  J: '#3333ff',\n  L: '#ff8800'\n};\n\nconst GLOW_COLORS = {\n  I: 'rgba(0,255,255,',\n  O: 'rgba(255,255,0,',\n  T: 'rgba(255,0,255,',\n  S: 'rgba(0,255,0,',\n  Z: 'rgba(255,51,51,',\n  J: 'rgba(51,51,255,',\n  L: 'rgba(255,136,0,'\n};\n\nconst SHAPES = {\n  I: [[0,0],[1,0],[2,0],[3,0]],\n  O: [[0,0],[1,0],[0,1],[1,1]],\n  T: [[0,0],[1,0],[2,0],[1,1]],\n  S: [[1,0],[2,0],[0,1],[1,1]],\n  Z: [[0,0],[1,0],[1,1],[2,1]],\n  J: [[0,0],[0,1],[1,1],[2,1]],\n  L: [[2,0],[0,1],[1,1],[2,1]]\n};\n\nlet board = [];\nlet currentPiece = null;\nlet nextPiece = null;\nlet score = 0;\nlet lines = 0;\nlet level = 1;\nlet gameRunning = false;\nlet gamePaused = false;\nlet dropInterval = 800;\nlet lastDrop = 0;\nlet particles = [];\nlet trailParticles = [];\nlet animFrame = 0;\nlet softDropSpeed = 0;\nlet lockDelay = 0;\nlet flashRows = [];\nlet flashTimer = 0;\n\n// Sound system using Web Audio API\nlet audioCtx = null;\n\nfunction initAudio() {\n  if (!audioCtx) {\n    audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n  }\n}\n\nfunction playSound(type) {\n  if (!audioCtx) return;\n  const now = audioCtx.currentTime;\n\n  switch(type) {\n    case 'move': {\n      const osc = audioCtx.createOscillator();\n      const gain = audioCtx.createGain();\n      osc.connect(gain);\n      gain.connect(audioCtx.destination);\n      osc.type = 'sine';\n      osc.frequency.setValueAtTime(300, now);\n      osc.frequency.exponentialRampToValueAtTime(200, now + 0.05);\n      gain.gain.setValueAtTime(0.08, now);\n      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);\n      osc.start(now);\n      osc.stop(now + 0.05);\n      break;\n    }\n    case 'rotate': {\n      const osc = audioCtx.createOscillator();\n      const gain = audioCtx.createGain();\n      osc.connect(gain);\n      gain.connect(audioCtx.destination);\n      osc.type = 'triangle';\n      osc.frequency.setValueAtTime(400, now);\n      osc.frequency.exponentialRampToValueAtTime(600, now + 0.08);\n      gain.gain.setValueAtTime(0.1, now);\n      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);\n      osc.start(now);\n      osc.stop(now + 0.08);\n      break;\n    }\n    case 'drop': {\n      const osc = audioCtx.createOscillator();\n      const gain = audioCtx.createGain();\n      osc.connect(gain);\n      gain.connect(audioCtx.destination);\n      osc.type = 'sine';\n      osc.frequency.setValueAtTime(150, now);\n      osc.frequency.exponentialRampToValueAtTime(50, now + 0.2);\n      gain.gain.setValueAtTime(0.15, now);\n      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);\n      osc.start(now);\n      osc.stop(now + 0.2);\n      break;\n    }\n    case 'line': {\n      const osc = audioCtx.createOscillator();\n      const gain = audioCtx.createGain();\n      osc.connect(gain);\n      gain.connect(audioCtx.destination);\n      osc.type = 'square';\n      osc.frequency.setValueAtTime(523, now);\n      osc.frequency.setValueAtTime(659, now + 0.08);\n      osc.frequency.setValueAtTime(784, now + 0.16);\n      osc.frequency.setValueAtTime(1047, now + 0.24);\n      gain.gain.setValueAtTime(0.12, now);\n      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);\n      osc.start(now);\n      osc.stop(now + 0.4);\n      break;\n    }\n    case 'tetris': {\n      [523, 659, 784, 1047, 1319].forEach((freq, i) => {\n        const osc = audioCtx.createOscillator();\n        const gain = audioCtx.createGain();\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n        osc.type = 'square';\n        osc.frequency.setValueAtTime(freq, now + i * 0.08);\n        gain.gain.setValueAtTime(0.1, now + i * 0.08);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.08 + 0.15);\n        osc.start(now + i * 0.08);\n        osc.stop(now + i * 0.08 + 0.15);\n      });\n      break;\n    }\n    case 'gameover': {\n      [400, 350, 300, 200, 150].forEach((freq, i) => {\n        const osc = audioCtx.createOscillator();\n        const gain = audioCtx.createGain();\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(freq, now + i * 0.15);\n        gain.gain.setValueAtTime(0.1, now + i * 0.15);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.15 + 0.2);\n        osc.start(now + i * 0.15);\n        osc.stop(now + i * 0.15 + 0.2);\n      });\n      break;\n    }\n    case 'levelup': {\n      [523, 659, 784, 1047].forEach((freq, i) => {\n        const osc = audioCtx.createOscillator();\n        const gain = audioCtx.createGain();\n        osc.connect(gain);\n        gain.connect(audioCtx.destination);\n        osc.type = 'triangle';\n        osc.frequency.setValueAtTime(freq, now + i * 0.1);\n        gain.gain.setValueAtTime(0.12, now + i * 0.1);\n        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.1 + 0.2);\n        osc.start(now + i * 0.1);\n        osc.stop(now + i * 0.1 + 0.2);\n      });\n      break;\n    }\n    case 'ghost': {\n      const osc = audioCtx.createOscillator();\n      const gain = audioCtx.createGain();\n      osc.connect(gain);\n      gain.connect(audioCtx.destination);\n      osc.type = 'sine';\n      osc.frequency.setValueAtTime(800, now);\n      osc.frequency.exponentialRampToValueAtTime(400, now + 0.03);\n      gain.gain.setValueAtTime(0.03, now);\n      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.03);\n      osc.start(now);\n      osc.stop(now + 0.03);\n      break;\n    }\n  }\n}\n\nfunction createBoard() {\n  board = [];\n  for (let r = 0; r < ROWS; r++) {\n    board[r] = [];\n    for (let c = 0; c < COLS; c++) {\n      board[r][c] = null;\n    }\n  }\n}\n\nfunction randomPiece() {\n  const types = ['I','O','T','S','Z','J','L'];\n  const type = types[Math.floor(Math.random() * types.length)];\n  return {\n    type: type,\n    blocks: SHAPES[type].map(b => [...b]),\n    x: Math.floor(COLS / 2) - 1,\n    y: 0\n  };\n}\n\nfunction rotatePiece(piece) {\n  const blocks = piece.blocks;\n  // Find center of rotation\n  let cx = 0, cy = 0;\n  blocks.forEach(b => { cx += b[0]; cy += b[1]; });\n  cx = Math.round(cx / blocks.length);\n  cy = Math.round(cy / blocks.length);\n\n  const rotated = blocks.map(b => {\n    const dx = b[0] - cx;\n    const dy = b[1] - cy;\n    return [cx - dy, cy + dx];\n  });\n\n  return rotated;\n}\n\nfunction isValid(blocks, ox, oy) {\n  for (const b of blocks) {\n    const nx = b[0] + ox;\n    const ny = b[1] + oy;\n    if (nx < 0 || nx >= COLS || ny >= ROWS) return false;\n    if (ny >= 0 && board[ny][nx] !== null) return false;\n  }\n  return true;\n}\n\nfunction placePiece() {\n  for (const b of currentPiece.blocks) {\n    const x = b[0] + currentPiece.x;\n    const y = b[1] + currentPiece.y;\n    if (y < 0) {\n      gameOver();\n      return;\n    }\n    board[y][x] = currentPiece.type;\n  }\n\n  // Spawn placement particles\n  for (const b of currentPiece.blocks) {\n    const x = b[0] + currentPiece.x;\n    const y = b[1] + currentPiece.y;\n    for (let i = 0; i < 5; i++) {\n      particles.push({\n        x: x * BLOCK + BLOCK/2,\n        y: y * BLOCK + BLOCK/2,\n        vx: (Math.random() - 0.5) * 4,\n        vy: (Math.random() - 0.5) * 4,\n        life: 1,\n        decay: 0.02 + Math.random() * 0.02,\n        color: COLORS[currentPiece.type],\n        size: 2 + Math.random() * 3\n      });\n    }\n  }\n\n  playSound('drop');\n  checkLines();\n  spawnPiece();\n}\n\nfunction checkLines() {\n  let cleared = [];\n  for (let r = ROWS - 1; r >= 0; r--) {\n    if (board[r].every(cell => cell !== null)) {\n      cleared.push(r);\n    }\n  }\n\n  if (cleared.length > 0) {\n    flashRows = cleared;\n    flashTimer = 15;\n\n    if (cleared.length === 4) {\n      playSound('tetris');\n    } else {\n      playSound('line');\n    }\n\n    setTimeout(() => {\n      for (const r of cleared) {\n        // Clear line particles\n        for (let c = 0; c < COLS; c++) {\n          const color = board[r][c] ? COLORS[board[r][c]] : '#fff';\n          for (let i = 0; i < 8; i++) {\n            particles.push({\n              x: c * BLOCK + BLOCK/2,\n              y: r * BLOCK + BLOCK/2,\n              vx: (Math.random() - 0.5) * 8,\n              vy: (Math.random() - 0.5) * 8,\n              life: 1,\n              decay: 0.015 + Math.random() * 0.015,\n              color: color,\n              size: 2 + Math.random() * 4\n            });\n          }\n        }\n      }\n\n      for (const r of cleared.sort((a,b) => a - b)) {\n        board.splice(r, 1);\n        board.unshift(new Array(COLS).fill(null));\n      }\n\n      flashRows = [];\n\n      const points = [0, 100, 300, 500, 800];\n      score += points[cleared.length] * level;\n      lines += cleared.length;\n      const newLevel = Math.floor(lines / 10) + 1;\n      if (newLevel > level) {\n        level = newLevel;\n        dropInterval = Math.max(50, 800 - (level - 1) * 70);\n        playSound('levelup');\n      }\n\n      updateDisplay();\n    }, 200);\n  }\n}\n\nfunction spawnPiece() {\n  currentPiece = nextPiece || randomPiece();\n  nextPiece = randomPiece();\n\n  if (!isValid(currentPiece.blocks, currentPiece.x, currentPiece.y)) {\n    gameOver();\n  }\n}\n\nfunction getGhostY() {\n  let gy = currentPiece.y;\n  while (isValid(currentPiece.blocks, currentPiece.x, gy + 1)) {\n    gy++;\n  }\n  return gy;\n}\n\nfunction hardDrop() {\n  const ghostY = getGhostY();\n  const dist = ghostY - currentPiece.y;\n  score += dist * 2;\n\n  // Create trail particles for hard drop\n  for (const b of currentPiece.blocks) {\n    const bx = b[0] + currentPiece.x;\n    for (let y = currentPiece.y; y < ghostY; y++) {\n      const by = b[1] + y;\n      if (by >= 0) {\n        trailParticles.push({\n          x: bx * BLOCK + BLOCK/2,\n          y: by * BLOCK + BLOCK/2,\n          life: 1,\n          decay: 0.04,\n          color: COLORS[currentPiece.type],\n          size: BLOCK * 0.3\n        });\n      }\n    }\n  }\n\n  currentPiece.y = ghostY;\n  updateDisplay();\n  placePiece();\n}\n\nfunction softDrop() {\n  if (isValid(currentPiece.blocks, currentPiece.x, currentPiece.y + 1)) {\n    // Add trail particles\n    for (const b of currentPiece.blocks) {\n      const bx = b[0] + currentPiece.x;\n      const by = b[1] + currentPiece.y;\n      trailParticles.push({\n        x: bx * BLOCK + BLOCK/2,\n        y: by * BLOCK + BLOCK * 0.8,\n        life: 1,\n        decay: 0.06,\n        color: COLORS[currentPiece.type],\n        size: BLOCK * 0.25\n      });\n    }\n\n    currentPiece.y++;\n    score += 1;\n    updateDisplay();\n    playSound('ghost');\n    return true;\n  }\n  return false;\n}\n\nfunction moveLeft() {\n  if (isValid(currentPiece.blocks, currentPiece.x - 1, currentPiece.y)) {\n    currentPiece.x--;\n    playSound('move');\n  }\n}\n\nfunction moveRight() {\n  if (isValid(currentPiece.blocks, currentPiece.x + 1, currentPiece.y)) {\n    currentPiece.x++;\n    playSound('move');\n  }\n}\n\nfunction rotate() {\n  const rotated = rotatePiece(currentPiece);\n  // Try normal rotation\n  if (isValid(rotated, currentPiece.x, currentPiece.y)) {\n    currentPiece.blocks = rotated;\n    playSound('rotate');\n    return;\n  }\n  // Wall kick attempts\n  const kicks = [[-1,0],[1,0],[-2,0],[2,0],[0,-1],[0,-2]];\n  for (const [kx, ky] of kicks) {\n    if (isValid(rotated, currentPiece.x + kx, currentPiece.y + ky)) {\n      currentPiece.blocks = rotated;\n      currentPiece.x += kx;\n      currentPiece.y += ky;\n      playSound('rotate');\n      return;\n    }\n  }\n}\n\nfunction updateDisplay() {\n  document.getElementById('scoreDisplay').textContent = score.toLocaleString();\n  document.getElementById('linesDisplay').textContent = lines;\n  document.getElementById('levelDisplay').textContent = level;\n}\n\nfunction drawBlock(context, x, y, type, size, alpha = 1, glow = false) {\n  const color = COLORS[type];\n  const glowColor = GLOW_COLORS[type];\n\n  context.save();\n  context.globalAlpha = alpha;\n\n  if (glow) {\n    context.shadowColor = color;\n    context.shadowBlur = 15;\n  }\n\n  // Main block\n  context.fillStyle = color;\n  context.fillRect(x + 1, y + 1, size - 2, size - 2);\n\n  // Inner highlight\n  context.fillStyle = 'rgba(255,255,255,0.25)';\n  context.fillRect(x + 1, y + 1, size - 2, size/3);\n\n  // Inner shadow\n  context.fillStyle = 'rgba(0,0,0,0.2)';\n  context.fillRect(x + 1, y + size * 0.65, size - 2, size * 0.35);\n\n  // Border\n  context.strokeStyle = 'rgba(255,255,255,0.3)';\n  context.lineWidth = 0.5;\n  context.strokeRect(x + 1, y + 1, size - 2, size - 2);\n\n  context.restore();\n}\n\nfunction drawBoard() {\n  // Background\n  ctx.fillStyle = '#0a0a15';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n  // Grid\n  ctx.strokeStyle = 'rgba(255,255,255,0.03)';\n  ctx.lineWidth = 0.5;\n  for (let r = 0; r <= ROWS; r++) {\n    ctx.beginPath();\n    ctx.moveTo(0, r * BLOCK);\n    ctx.lineTo(canvas.width, r * BLOCK);\n    ctx.stroke();\n  }\n  for (let c = 0; c <= COLS; c++) {\n    ctx.beginPath();\n    ctx.moveTo(c * BLOCK, 0);\n    ctx.lineTo(c * BLOCK, canvas.height);\n    ctx.stroke();\n  }\n\n  // Placed blocks\n  for (let r = 0; r < ROWS; r++) {\n    for (let c = 0; c < COLS; c++) {\n      if (board[r][c]) {\n        const isFlashing = flashRows.includes(r);\n        if (isFlashing) {\n          const flashAlpha = Math.abs(Math.sin(flashTimer * 0.5));\n          drawBlock(ctx, c * BLOCK, r * BLOCK, board[r][c], BLOCK, flashAlpha, true);\n        } else {\n          drawBlock(ctx, c * BLOCK, r * BLOCK, board[r][c], BLOCK, 1, false);\n        }\n      }\n    }\n  }\n\n  if (!currentPiece || flashRows.length > 0) return;\n\n  // Ghost piece\n  const ghostY = getGhostY();\n  if (ghostY !== currentPiece.y) {\n    for (const b of currentPiece.blocks) {\n      const gx = b[0] + currentPiece.x;\n      const gy = b[1] + ghostY;\n      if (gy >= 0) {\n        ctx.save();\n        ctx.globalAlpha = 0.15;\n        ctx.fillStyle = COLORS[currentPiece.type];\n        ctx.fillRect(gx * BLOCK + 1, gy * BLOCK + 1, BLOCK - 2, BLOCK - 2);\n        ctx.strokeStyle = COLORS[currentPiece.type];\n        ctx.lineWidth = 1;\n        ctx.strokeRect(gx * BLOCK + 1, gy * BLOCK + 1, BLOCK - 2, BLOCK - 2);\n        ctx.restore();\n      }\n    }\n  }\n\n  // Current piece\n  for (const b of currentPiece.blocks) {\n    const bx = b[0] + currentPiece.x;\n    const by = b[1] + currentPiece.y;\n    if (by >= 0) {\n      drawBlock(ctx, bx * BLOCK, by * BLOCK, currentPiece.type, BLOCK, 1, true);\n    }\n  }\n}\n\nfunction drawNextPiece() {\n  nextCtx.fillStyle = 'transparent';\n  nextCtx.clearRect(0, 0, nextCanvas.width, nextCanvas.height);\n\n  if (!nextPiece) return;\n\n  const blocks = nextPiece.blocks;\n  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;\n  blocks.forEach(b => {\n    minX = Math.min(minX, b[0]);\n    maxX = Math.max(maxX, b[0]);\n    minY = Math.min(minY, b[1]);\n    maxY = Math.max(maxY, b[1]);\n  });\n\n  const pw = (maxX - minX + 1) * NEXT_BLOCK;\n  const ph = (maxY - minY + 1) * NEXT_BLOCK;\n  const ox = (nextCanvas.width - pw) / 2 - minX * NEXT_BLOCK;\n  const oy = (nextCanvas.height - ph) / 2 - minY * NEXT_BLOCK;\n\n  for (const b of blocks) {\n    drawBlock(nextCtx, b[0] * NEXT_BLOCK + ox, b[1] * NEXT_BLOCK + oy, nextPiece.type, NEXT_BLOCK, 1, true);\n  }\n}\n\nfunction updateParticles() {\n  particles = particles.filter(p => {\n    p.x += p.vx;\n    p.y += p.vy;\n    p.vy += 0.1;\n    p.life -= p.decay;\n    return p.life > 0;\n  });\n\n  trailParticles = trailParticles.filter(p => {\n    p.life -= p.decay;\n    return p.life > 0;\n  });\n}\n\nfunction drawParticles() {\n  // Trail particles (glowing trail effect)\n  for (const p of trailParticles) {\n    ctx.save();\n    ctx.globalAlpha = p.life * 0.6;\n    ctx.shadowColor = p.color;\n    ctx.shadowBlur = 10;\n    ctx.fillStyle = p.color;\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n  }\n\n  // Explosion particles\n  for (const p of particles) {\n    ctx.save();\n    ctx.globalAlpha = p.life;\n    ctx.shadowColor = p.color;\n    ctx.shadowBlur = 8;\n    ctx.fillStyle = p.color;\n    ctx.beginPath();\n    ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.restore();\n  }\n}\n\nfunction drawScanlines() {\n  ctx.save();\n  ctx.globalAlpha = 0.03;\n  for (let y = 0; y < canvas.height; y += 2) {\n    ctx.fillStyle = '#000';\n    ctx.fillRect(0, y, canvas.width, 1);\n  }\n  ctx.restore();\n}\n\nlet lastTime = 0;\nlet dropTimer = 0;\nlet softDropHeld = false;\n\nfunction gameLoop(timestamp) {\n  if (!gameRunning) return;\n  if (gamePaused) {\n    requestAnimationFrame(gameLoop);\n    return;\n  }\n\n  const dt = timestamp - lastTime;\n  lastTime = timestamp;\n  animFrame++;\n\n  if (flashTimer > 0) flashTimer--;\n\n  // Auto drop\n  dropTimer += dt;\n  if (dropTimer >= dropInterval) {\n    dropTimer = 0;\n    if (isValid(currentPiece.blocks, currentPiece.x, currentPiece.y + 1)) {\n      currentPiece.y++;\n    } else {\n      placePiece();\n    }\n  }\n\n  // Soft drop\n  if (softDropHeld) {\n    if (softDropSpeed === 0 || animFrame % 4 === 0) {\n      softDrop();\n    }\n    softDropSpeed++;\n  }\n\n  updateParticles();\n\n  drawBoard();\n  drawParticles();\n  drawScanlines();\n  drawNextPiece();\n\n  requestAnimationFrame(gameLoop);\n}\n\nfunction gameOver() {\n  gameRunning = false;\n  playSound('gameover');\n  document.getElementById('finalScore').textContent = score.toLocaleString();\n  document.getElementById('finalLines').textContent = 'Lines: ' + lines + ' | Level: ' + level;\n  document.getElementById('gameOverOverlay').classList.remove('hidden');\n}\n\nfunction togglePause() {\n  if (!gameRunning) return;\n  gamePaused = !gamePaused;\n  if (gamePaused) {\n    document.getElementById('pauseOverlay').classList.remove('hidden');\n  } else {\n    document.getElementById('pauseOverlay').classList.add('hidden');\n    lastTime = performance.now();\n    requestAnimationFrame(gameLoop);\n  }\n}\n\nfunction startGame() {\n  initAudio();\n  createBoard();\n  score = 0;\n  lines = 0;\n  level = 1;\n  dropInterval = 800;\n  particles = [];\n  trailParticles = [];\n  flashRows = [];\n  flashTimer = 0;\n  dropTimer = 0;\n  softDropSpeed = 0;\n\n  document.getElementById('startOverlay').classList.add('hidden');\n  document.getElementById('gameOverOverlay').classList.add('hidden');\n  document.getElementById('pauseOverlay').classList.add('hidden');\n\n  updateDisplay();\n  spawnPiece();\n  gameRunning = true;\n  gamePaused = false;\n  lastTime = performance.now();\n  requestAnimationFrame(gameLoop);\n}\n\n// Keyboard controls\ndocument.addEventListener('keydown', (e) => {\n  if (!gameRunning || gamePaused) {\n    if (e.key === 'p' || e.key === 'P') togglePause();\n    return;\n  }\n\n  switch(e.key) {\n    case 'ArrowLeft':\n      e.preventDefault();\n      moveLeft();\n      break;\n    case 'ArrowRight':\n      e.preventDefault();\n      moveRight();\n      break;\n    case 'ArrowDown':\n      e.preventDefault();\n      softDropHeld = true;\n      softDrop();\n      break;\n    case 'ArrowUp':\n      e.preventDefault();\n      rotate();\n      break;\n    case ' ':\n      e.preventDefault();\n      hardDrop();\n      break;\n    case 'p':\n    case 'P':\n      togglePause();\n      break;\n  }\n});\n\ndocument.addEventListener('keyup', (e) => {\n  if (e.key === 'ArrowDown') {\n    softDropHeld = false;\n    softDropSpeed = 0;\n  }\n});\n\n// Touch controls\nconst btnLeft = document.getElementById('btnLeft');\nconst btnRight = document.getElementById('btnRight');\nconst btnDown = document.getElementById('btnDown');\nconst btnRotate = document.getElementById('btnRotate');\nconst btnDrop = document.getElementById('btnDrop');\n\nfunction addTouchEvents(el, action) {\n  let interval = null;\n  let timeout = null;\n\n  const start = (e) => {\n    e.preventDefault();\n    if (!gameRunning || gamePaused) return;\n    action();\n    // Repeat for hold\n    timeout = setTimeout(() => {\n      interval = setInterval(() => {\n        if (!gameRunning || gamePaused) return;\n        action();\n      }, 80);\n    }, 200);\n  };\n\n  const end = (e) => {\n    e.preventDefault();\n    clearTimeout(timeout);\n    clearInterval(interval);\n    if (action === softDrop) {\n      softDropHeld = false;\n      softDropSpeed = 0;\n    }\n  };\n\n  el.addEventListener('touchstart', start, { passive: false });\n  el.addEventListener('touchend', end, { passive: false });\n  el.addEventListener('touchcancel', end, { passive: false });\n  el.addEventListener('mousedown', start);\n  el.addEventListener('mouseup', end);\n  el.addEventListener('mouseleave', end);\n}\n\naddTouchEvents(btnLeft, moveLeft);\naddTouchEvents(document.getElementById('btnRight') || btnLeft.nextElementSibling, moveRight);\n\n// Fix: the right button doesn't exist in the HTML, let me use the existing layout\n// Actually looking at the HTML, there's no btnRight. Let me handle the d-pad differently.\n\n// Re-setup touch controls properly\nbtnLeft.addEventListener('touchstart', (e) => { e.preventDefault(); if(gameRunning && !gamePaused) moveLeft(); }, {passive:false});\nbtnDown.addEventListener('touchstart', (e) => {\n  e.preventDefault();\n  if(gameRunning && !gamePaused) { softDropHeld = true; softDrop(); }\n}, {passive:false});\nbtnDown.addEventListener('touchend', (e) => {\n  e.preventDefault();\n  softDropHeld = false;\n  softDropSpeed = 0;\n}, {passive:false});\nbtnRotate.addEventListener('touchstart', (e) => { e.preventDefault(); if(gameRunning && !gamePaused) rotate(); }, {passive:false});\nbtnDrop.addEventListener('touchstart', (e) => { e.preventDefault(); if(gameRunning && !gamePaused) hardDrop(); }, {passive:false});\n\n// Add right button functionality to the d-pad\n// Create a right button dynamically\nconst dPad = document.querySelector('.d-pad');\nconst rightBtn = document.createElement('button');\nrightBtn.id = 'btnRight';\nrightBtn.textContent = '▶';\nrightBtn.style.cssText = 'background:rgba(0,255,255,0.08);border:1px solid rgba(0,255,255,0.2);border-radius:10px;color:rgba(0,255,255,0.5);font-size:18px;display:flex;align-items:center;justify-content:center;cursor:pointer;-webkit-tap-highlight-color:transparent;user-select:none;';\ndPad.appendChild(rightBtn);\n\nrightBtn.addEventListener('touchstart', (e) => { e.preventDefault(); if(gameRunning && !gamePaused) moveRight(); }, {passive:false});\nrightBtn.addEventListener('mousedown', (e) => { if(gameRunning && !gamePaused) moveRight(); });\n\n// Update d-pad grid\ndPad.style.gridTemplateColumns = '45px 45px 45px';\ndPad.style.gridTemplateRows = '45px 45px';\n\n// Position buttons correctly\nbtnLeft.style.gridColumn = '1';\nbtnLeft.style.gridRow = '2';\nrightBtn.style.gridColumn = '3';\nrightBtn.style.gridRow = '2';\nbtnDown.style.gridColumn = '2';\nbtnDown.style.gridRow = '2';\nbtnRotate.style.gridColumn = '2';\nbtnRotate.style.gridRow = '1';\n\n// Update clock\nfunction updateClock() {\n  const now = new Date();\n  const h = now.getHours();\n  const m = now.getMinutes().toString().padStart(2, '0');\n  document.getElementById('clockTime').textContent = h + ':' + m;\n}\nupdateClock();\nsetInterval(updateClock, 30000);\n\n// Initial draw\ndrawBoard();\n</script>\n</body>\n</html>"
}