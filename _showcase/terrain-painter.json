{
 "id": "terrain-painter",
 "bench": "prompt-gallery",
 "title": "Terrain Painter",
 "note": "Devin CLI / swe-2-max",
 "rating": "5/5",
 "kind": "html",
 "prompt": "Create a single-page Three.js terrain editor with height painting. Start with a flat grid plane that the user can sculpt by painting height values. Include raise/lower/smooth/flatten brush modes, adjustable brush size and strength, texture layers (grass, rock, snow) painted by altitude, water level slider, and a minimap showing the terrain from above. Export the heightmap as an image.",
 "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>TerraForge — Terrain Editor</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --bg:#070b11;\n    --panel:rgba(13,18,26,.82);\n    --border:rgba(255,255,255,.09);\n    --txt:#e8eef5;\n    --dim:#8b99a8;\n    --accent:#5eead4;\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--txt);\n    font-family:'Inter',system-ui,-apple-system,sans-serif;font-size:13px}\n  canvas.webgl{position:fixed;inset:0;display:block;touch-action:none}\n  .vignette{position:fixed;inset:0;pointer-events:none;z-index:5;\n    background:radial-gradient(ellipse at center,transparent 55%,rgba(0,0,0,.45) 100%)}\n\n  .brand{position:fixed;top:18px;left:20px;z-index:10;pointer-events:none}\n  .brand h1{font-size:17px;font-weight:800;letter-spacing:.28em;color:#fff}\n  .brand h1 em{color:var(--accent);font-style:normal}\n  .brand p{font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--dim);margin-top:3px}\n\n  .panel{position:fixed;z-index:10;background:var(--panel);border:1px solid var(--border);\n    border-radius:14px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);\n    box-shadow:0 12px 40px rgba(0,0,0,.5);padding:16px}\n  .panel.left{top:78px;left:20px;width:242px;max-height:calc(100vh - 110px);overflow-y:auto}\n  .panel.right{top:18px;right:20px;width:248px}\n  .panel::-webkit-scrollbar{width:6px}\n  .panel::-webkit-scrollbar-thumb{background:rgba(255,255,255,.15);border-radius:3px}\n\n  .sect{font-size:10px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;\n    color:var(--dim);margin:14px 0 10px;display:flex;align-items:center;gap:8px}\n  .sect:first-child{margin-top:0}\n  .sect::after{content:'';flex:1;height:1px;background:var(--border)}\n\n  .modes{display:grid;grid-template-columns:1fr 1fr;gap:7px}\n  .mode{display:flex;flex-direction:column;align-items:center;gap:5px;padding:10px 4px 8px;\n    background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:9px;\n    color:var(--dim);font:inherit;font-size:11px;font-weight:600;cursor:pointer;\n    transition:all .15s ease}\n  .mode svg{width:22px;height:22px}\n  .mode:hover{background:rgba(255,255,255,.08);color:var(--txt)}\n  .mode.active{color:#0b1016;border-color:transparent}\n  .mode.active[data-mode=\"raise\"]{background:#4ade80;box-shadow:0 0 18px rgba(74,222,128,.35)}\n  .mode.active[data-mode=\"lower\"]{background:#fb923c;box-shadow:0 0 18px rgba(251,146,60,.35)}\n  .mode.active[data-mode=\"smooth\"]{background:#a78bfa;box-shadow:0 0 18px rgba(167,139,250,.35)}\n  .mode.active[data-mode=\"flatten\"]{background:#facc15;box-shadow:0 0 18px rgba(250,204,21,.35)}\n\n  label.sl{display:flex;justify-content:space-between;font-size:11.5px;font-weight:500;\n    color:#c4cedb;margin-top:4px}\n  label.sl span{color:var(--accent);font-weight:700;font-variant-numeric:tabular-nums}\n  input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:4px;\n    border-radius:2px;background:rgba(255,255,255,.14);outline:none;margin:9px 0 13px;cursor:pointer}\n  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;\n    border-radius:50%;background:var(--accent);border:2px solid #0b1016;\n    box-shadow:0 0 0 2px rgba(94,234,212,.35);cursor:pointer}\n  input[type=range]::-moz-range-thumb{width:12px;height:12px;border-radius:50%;\n    background:var(--accent);border:2px solid #0b1016;cursor:pointer}\n  input[type=range]::-moz-range-track{height:4px;border-radius:2px;background:rgba(255,255,255,.14)}\n\n  .chk{display:flex;align-items:center;gap:8px;font-size:12px;color:#c4cedb;\n    cursor:pointer;margin:2px 0 6px;user-select:none}\n  .chk input{accent-color:var(--accent);width:14px;height:14px;cursor:pointer}\n\n  .hint{margin-top:12px;padding-top:11px;border-top:1px solid var(--border);\n    font-size:10.5px;line-height:1.75;color:var(--dim)}\n  .hint b{color:#c4cedb;font-weight:600}\n\n  #minimap{width:100%;display:block;border-radius:10px;border:1px solid var(--border);\n    background:#000;image-rendering:auto}\n  .btns{display:flex;gap:7px;margin-top:11px}\n  .btn{flex:1;padding:9px 6px;border-radius:8px;border:1px solid var(--border);\n    background:rgba(255,255,255,.05);color:var(--txt);font:inherit;font-size:11.5px;\n    font-weight:600;cursor:pointer;transition:all .15s}\n  .btn:hover{background:rgba(255,255,255,.11)}\n  .btn.primary{background:linear-gradient(135deg,#2dd4bf,#0ea5a4);color:#06231f;\n    border-color:transparent}\n  .btn.primary:hover{filter:brightness(1.12)}\n  .readout{margin-top:10px;font-size:10.5px;color:var(--dim);text-align:center;\n    font-variant-numeric:tabular-nums;min-height:14px;letter-spacing:.04em}\n\n  @media (max-width:720px){\n    .panel.left{top:auto;bottom:12px;left:12px;width:206px;max-height:52vh}\n    .panel.right{top:12px;right:12px;width:170px}\n    .brand{top:12px;left:14px}\n  }\n</style>\n<script type=\"importmap\">\n{\"imports\":{\n  \"three\":\"https://unpkg.com/three@0.160.0/build/three.module.js\",\n  \"three/addons/\":\"https://unpkg.com/three@0.160.0/examples/jsm/\"\n}}\n</script>\n</head>\n<body>\n\n<header class=\"brand\">\n  <h1>TERRA<em>FORGE</em></h1>\n  <p>procedural terrain editor</p>\n</header>\n\n<div class=\"panel left\">\n  <div class=\"sect\">Brush</div>\n  <div class=\"modes\">\n    <button class=\"mode active\" data-mode=\"raise\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 17 L9.5 7 L16 17\"/><path d=\"M19.5 16.5 V8.5\"/><path d=\"M16.8 11.2 L19.5 8.5 L22.2 11.2\"/></svg>\n      Raise</button>\n    <button class=\"mode\" data-mode=\"lower\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 17 L9.5 7 L16 17\"/><path d=\"M19.5 8.5 V16.5\"/><path d=\"M16.8 13.8 L19.5 16.5 L22.2 13.8\"/></svg>\n      Lower</button>\n    <button class=\"mode\" data-mode=\"smooth\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12 Q7 6 11 12 T19 12\"/><path d=\"M3 18 H21\"/></svg>\n      Smooth</button>\n    <button class=\"mode\" data-mode=\"flatten\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 16 L8 9 H16 L21 16\"/><path d=\"M3 20 H21\"/></svg>\n      Flatten</button>\n  </div>\n\n  <label class=\"sl\">Brush size <span id=\"sizeVal\">12.0</span></label>\n  <input type=\"range\" id=\"size\" min=\"2\" max=\"40\" step=\"0.5\" value=\"12\">\n  <label class=\"sl\">Strength <span id=\"strVal\">35%</span></label>\n  <input type=\"range\" id=\"strength\" min=\"1\" max=\"100\" step=\"1\" value=\"35\">\n\n  <div class=\"sect\">Environment</div>\n  <label class=\"sl\">Water level <span id=\"waterVal\">-6.0</span></label>\n  <input type=\"range\" id=\"water\" min=\"-30\" max=\"70\" step=\"0.5\" value=\"-6\">\n  <label class=\"sl\">Snow line <span id=\"snowVal\">45</span></label>\n  <input type=\"range\" id=\"snow\" min=\"10\" max=\"90\" step=\"1\" value=\"45\">\n  <label class=\"chk\"><input type=\"checkbox\" id=\"grid\" checked> Surface grid overlay</label>\n\n  <div class=\"hint\">\n    <b>LMB</b> sculpt &nbsp;·&nbsp; <b>RMB</b> orbit &nbsp;·&nbsp; <b>wheel</b> zoom &nbsp;·&nbsp; <b>MMB</b> pan<br>\n    <b>1–4</b> brush mode &nbsp;·&nbsp; <b>[</b> <b>]</b> brush size &nbsp;·&nbsp; <b>G</b> grid\n  </div>\n</div>\n\n<div class=\"panel right\">\n  <div class=\"sect\">Minimap</div>\n  <canvas id=\"minimap\" width=\"256\" height=\"256\"></canvas>\n  <div class=\"btns\">\n    <button class=\"btn primary\" id=\"export\">Export heightmap</button>\n    <button class=\"btn\" id=\"reset\">Reset</button>\n  </div>\n  <div class=\"readout\" id=\"readout\">hover terrain to inspect</div>\n</div>\n\n<div class=\"vignette\"></div>\n\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n\n/* ---------- constants & state ---------- */\nconst SIZE = 200, RES = 256, CELL = SIZE / (RES - 1);\nconst HMIN = -30, HMAX = 90;\nconst heights = new Float32Array(RES * RES);          // flat at 0\n\nlet mode = 'raise';\nlet brushRadius = 12, brushStrength = 0.35;\nlet waterLevel = -6, snowH = 45, showGrid = true;\n\nconst MODES = {\n  raise:   { color: 0x4ade80, css: '#4ade80' },\n  lower:   { color: 0xfb923c, css: '#fb923c' },\n  smooth:  { color: 0xa78bfa, css: '#a78bfa' },\n  flatten: { color: 0xfacc15, css: '#facc15' }\n};\n\n/* ---------- renderer / scene ---------- */\nconst renderer = new THREE.WebGLRenderer({ antialias: true });\nrenderer.setPixelRatio(Math.min(devicePixelRatio, 2));\nrenderer.setSize(innerWidth, innerHeight);\nrenderer.shadowMap.enabled = true;\nrenderer.shadowMap.type = THREE.PCFSoftShadowMap;\nrenderer.toneMapping = THREE.ACESFilmicToneMapping;\nrenderer.toneMappingExposure = 1.05;\nrenderer.domElement.className = 'webgl';\ndocument.body.appendChild(renderer.domElement);\n\nconst scene = new THREE.Scene();\nscene.fog = new THREE.Fog(0x16283e, 340, 1100);\n\n// vertical gradient sky backdrop\n{\n  const c = document.createElement('canvas'); c.width = 2; c.height = 512;\n  const x = c.getContext('2d');\n  const g = x.createLinearGradient(0, 0, 0, 512);\n  g.addColorStop(0, '#04070d'); g.addColorStop(.45, '#0c1a2c');\n  g.addColorStop(.72, '#1d3a54'); g.addColorStop(.9, '#3f6b8a'); g.addColorStop(1, '#6f9db4');\n  x.fillStyle = g; x.fillRect(0, 0, 2, 512);\n  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace;\n  scene.background = t;\n}\n\nconst camera = new THREE.PerspectiveCamera(55, innerWidth / innerHeight, 0.1, 3000);\ncamera.position.set(108, 88, 132);\n\nconst controls = new OrbitControls(camera, renderer.domElement);\ncontrols.target.set(0, 6, 0);\ncontrols.enableDamping = true; controls.dampingFactor = 0.08;\ncontrols.minDistance = 25; controls.maxDistance = 750;\ncontrols.maxPolarAngle = 1.52;\ncontrols.mouseButtons = { LEFT: -1, MIDDLE: THREE.MOUSE.PAN, RIGHT: THREE.MOUSE.ROTATE };\ncontrols.touches = { ONE: -1, TWO: THREE.TOUCH.DOLLY_PAN };\ncontrols.screenSpacePanning = false;\n\n/* ---------- lights ---------- */\nscene.add(new THREE.HemisphereLight(0x9db8d9, 0x2a3026, 0.55));\nconst sun = new THREE.DirectionalLight(0xffe7c4, 2.7);\nsun.position.set(140, 190, 90);\nsun.castShadow = true;\nsun.shadow.mapSize.set(2048, 2048);\nsun.shadow.camera.left = -150; sun.shadow.camera.right = 150;\nsun.shadow.camera.top = 150;   sun.shadow.camera.bottom = -150;\nsun.shadow.camera.near = 40;   sun.shadow.camera.far = 520;\nsun.shadow.bias = -0.0004;     sun.shadow.normalBias = 1.2;\nscene.add(sun);\nconst LIGHT_DIR = sun.position.clone().normalize();\n\n/* ---------- procedural textures ---------- */\nfunction vnoise(size, cells) {                       // tileable value noise\n  const g = new Float32Array((cells + 1) * (cells + 1));\n  for (let i = 0; i < g.length; i++) g[i] = Math.random();\n  for (let x = 0; x <= cells; x++) g[cells * (cells + 1) + x] = g[x];\n  for (let y = 0; y <= cells; y++) g[y * (cells + 1) + cells] = g[y * (cells + 1)];\n  const out = new Float32Array(size * size);\n  for (let y = 0; y < size; y++) {\n    const fy = y / size * cells, y0 = Math.floor(fy), ty = fy - y0;\n    for (let x = 0; x < size; x++) {\n      const fx = x / size * cells, x0 = Math.floor(fx), tx = fx - x0;\n      const a = g[y0 * (cells + 1) + x0],       b = g[y0 * (cells + 1) + x0 + 1];\n      const c2 = g[(y0 + 1) * (cells + 1) + x0], d = g[(y0 + 1) * (cells + 1) + x0 + 1];\n      out[y * size + x] = a + (b - a) * tx + (c2 - a) * ty + (a - b - c2 + d) * tx * ty;\n    }\n  }\n  return out;\n}\nconst clamp255 = v => v < 0 ? 0 : v > 255 ? 255 : v;\nfunction makeTex(size, fn, srgb = true) {\n  const cv = document.createElement('canvas'); cv.width = cv.height = size;\n  const ctx = cv.getContext('2d'), img = ctx.createImageData(size, size);\n  const A = vnoise(size, 12), B = vnoise(size, 42), C = vnoise(size, 110);\n  for (let i = 0; i < size * size; i++) {\n    const c = fn(A[i], B[i], C[i]);\n    img.data[i * 4] = clamp255(c[0]); img.data[i * 4 + 1] = clamp255(c[1]);\n    img.data[i * 4 + 2] = clamp255(c[2]); img.data[i * 4 + 3] = 255;\n  }\n  ctx.putImageData(img, 0, 0);\n  const t = new THREE.CanvasTexture(cv);\n  t.wrapS = t.wrapT = THREE.RepeatWrapping;\n  if (srgb) t.colorSpace = THREE.SRGBColorSpace;\n  t.anisotropy = renderer.capabilities.getMaxAnisotropy();\n  return t;\n}\nconst grassTex = makeTex(256, (a, b, c) => {\n  const n = a * .55 + b * .3 + c * .15;\n  let r = 74 + n * 55, g = 112 + n * 62, bl = 48 + n * 30;\n  if (a > .72) { r += 34; g += 22; bl -= 8; }\n  return [r, g, bl];\n});\nconst rockTex = makeTex(256, (a, b, c) => {\n  const n = a * .5 + b * .3 + c * .2;\n  let v = 86 + n * 96; if (b < .32) v *= .72;\n  return [v * 1.03, v * .97, v * .9];\n});\nconst snowTex = makeTex(256, (a, b, c) => {\n  const v = 226 + (b * .6 + c * .4) * 28;\n  return [v - 10, v - 4, v];\n});\nconst sandTex = makeTex(256, (a, b, c) => {\n  const n = b * .6 + c * .4;\n  return [188 + n * 38, 168 + n * 34, 124 + n * 26];\n});\nconst noiseTex = makeTex(256, a => [a * 255, a * 255, a * 255], false);\nconst waterTex = makeTex(256, (a, b) => {\n  const n = a * .6 + b * .4;\n  return [18 + n * 26, 84 + n * 54, 126 + n * 62];\n});\nwaterTex.repeat.set(14, 14);\n\n/* ---------- terrain ---------- */\nconst geo = new THREE.PlaneGeometry(SIZE, SIZE, RES - 1, RES - 1);\ngeo.boundingSphere = new THREE.Sphere(new THREE.Vector3(), 400); // raycast-safe\nconst posAttr = geo.attributes.position;\nconst nrmAttr = geo.attributes.normal;\n\nconst terrMat = new THREE.MeshStandardMaterial({ roughness: .95, metalness: 0 });\nterrMat.onBeforeCompile = sh => {\n  Object.assign(sh.uniforms, {\n    grassMap: { value: grassTex }, rockMap: { value: rockTex },\n    snowMap:  { value: snowTex },  sandMap: { value: sandTex },\n    noiseMap: { value: noiseTex },\n    uWater: { value: waterLevel }, uSnowH: { value: snowH }, uRockH: { value: 40 },\n    uTexScale: { value: .085 }, uShowGrid: { value: 1 }, uGridStep: { value: CELL * 8 }\n  });\n  sh.vertexShader = sh.vertexShader\n    .replace('#include <common>', '#include <common>\\nvarying vec3 vWPos;varying vec3 vWNorm;')\n    .replace('#include <fog_vertex>',\n      'vWPos=(modelMatrix*vec4(transformed,1.0)).xyz;\\n' +\n      'vWNorm=normalize(mat3(modelMatrix)*objectNormal);\\n#include <fog_vertex>');\n  sh.fragmentShader = sh.fragmentShader\n    .replace('#include <common>', `#include <common>\n      uniform sampler2D grassMap,rockMap,snowMap,sandMap,noiseMap;\n      uniform float uWater,uSnowH,uRockH,uTexScale,uShowGrid,uGridStep;\n      varying vec3 vWPos;varying vec3 vWNorm;`)\n    .replace('#include <map_fragment>', `{\n      vec2 tuv=vWPos.xz*uTexScale;\n      vec3 gcol=texture2D(grassMap,tuv).rgb;\n      vec3 rcol=texture2D(rockMap,tuv).rgb;\n      vec3 scol=texture2D(snowMap,tuv).rgb;\n      vec3 sdcol=texture2D(sandMap,tuv).rgb;\n      float nz=texture2D(noiseMap,vWPos.xz*0.013).r;\n      float slope=1.0-clamp(vWNorm.y,0.0,1.0);\n      float rockS=smoothstep(0.30,0.52,slope+(nz-0.5)*0.12);\n      float rockHf=smoothstep(uRockH-7.0,uRockH+7.0,vWPos.y+(nz-0.5)*9.0);\n      float rockF=max(rockS,rockHf*0.85);\n      float snowF=smoothstep(uSnowH-5.0,uSnowH+5.0,vWPos.y+(nz-0.5)*10.0)*(1.0-rockS*0.85);\n      vec3 col=mix(gcol,rcol,clamp(rockF,0.0,1.0));\n      col=mix(col,scol,clamp(snowF,0.0,1.0));\n      float sandF=smoothstep(uWater+3.5,uWater+0.8,vWPos.y)*smoothstep(uWater-14.0,uWater-2.0,vWPos.y);\n      col=mix(col,sdcol,sandF*(1.0-snowF));\n      float sub=smoothstep(uWater-0.5,uWater-9.0,vWPos.y);\n      col*=mix(vec3(1.0),vec3(0.42,0.62,0.72),sub);\n      if(uShowGrid>0.5){\n        vec2 fr=fract(vWPos.xz/uGridStep);\n        vec2 dl=min(fr,1.0-fr)*uGridStep;\n        float line=1.0-smoothstep(0.10,0.24,min(dl.x,dl.y));\n        col=mix(col,vec3(0.85,0.95,1.0),line*0.30);\n      }\n      diffuseColor.rgb*=col;\n    }`);\n  terrMat.userData.sh = sh;\n};\n\nconst terrain = new THREE.Mesh(geo, terrMat);\nterrain.rotation.x = -Math.PI / 2;\nterrain.castShadow = terrain.receiveShadow = true;\nscene.add(terrain);\n\n/* ---------- water ---------- */\nconst water = new THREE.Mesh(\n  new THREE.PlaneGeometry(SIZE * 4, SIZE * 4),\n  new THREE.MeshStandardMaterial({\n    map: waterTex, color: 0x9fd4e8, transparent: true, opacity: .78,\n    roughness: .15, metalness: 0, depthWrite: false, side: THREE.DoubleSide\n  })\n);\nwater.rotation.x = -Math.PI / 2;\nwater.position.y = waterLevel;\nwater.receiveShadow = true;\nscene.add(water);\n\n/* ---------- brush indicator (terrain-conforming ring + disc) ---------- */\nconst RSEG = 96;\nconst brushGroup = new THREE.Group(); brushGroup.visible = false; scene.add(brushGroup);\nconst ringPos = new Float32Array(RSEG * 3);\nconst ringGeo = new THREE.BufferGeometry();\nringGeo.setAttribute('position', new THREE.BufferAttribute(ringPos, 3));\nconst ringMat = new THREE.LineBasicMaterial({ transparent: true, opacity: .95 });\nconst ring = new THREE.LineLoop(ringGeo, ringMat);\nring.frustumCulled = false;\nconst discPos = new Float32Array((RSEG + 1) * 3);\nconst discIdx = [];\nfor (let k = 0; k < RSEG; k++) discIdx.push(0, k + 1, (k + 1) % RSEG + 1);\nconst discGeo = new THREE.BufferGeometry();\ndiscGeo.setAttribute('position', new THREE.BufferAttribute(discPos, 3));\ndiscGeo.setIndex(discIdx);\nconst discMat = new THREE.MeshBasicMaterial({ transparent: true, opacity: .1, side: THREE.DoubleSide, depthWrite: false });\nconst disc = new THREE.Mesh(discGeo, discMat);\ndisc.frustumCulled = false;\nbrushGroup.add(ring, disc);\n\n/* ---------- heightfield helpers ---------- */\nfunction sampleH(wx, wz) {\n  const fx = Math.min(Math.max((wx + SIZE / 2) / CELL, 0), RES - 1.001);\n  const fy = Math.min(Math.max((wz + SIZE / 2) / CELL, 0), RES - 1.001);\n  const x0 = Math.floor(fx), y0 = Math.floor(fy), tx = fx - x0, ty = fy - y0;\n  const h00 = heights[y0 * RES + x0], h10 = heights[y0 * RES + x0 + 1];\n  const h01 = heights[(y0 + 1) * RES + x0], h11 = heights[(y0 + 1) * RES + x0 + 1];\n  return h00 + (h10 - h00) * tx + (h01 - h00) * ty + (h00 - h10 - h01 + h11) * tx * ty;\n}\nfunction updateNormals() {\n  const H = heights, n = nrmAttr.array, c2 = 2 * CELL;\n  for (let iy = 0; iy < RES; iy++) {\n    const yu = iy > 0 ? iy - 1 : 0, yd = iy < RES - 1 ? iy + 1 : RES - 1;\n    for (let ix = 0; ix < RES; ix++) {\n      const xl = ix > 0 ? ix - 1 : 0, xr = ix < RES - 1 ? ix + 1 : RES - 1;\n      const hx = H[iy * RES + xr] - H[iy * RES + xl];\n      const hy = H[yd * RES + ix] - H[yu * RES + ix];\n      const il = 1 / Math.hypot(hx, hy, c2), o = (iy * RES + ix) * 3;\n      n[o] = -hx * il; n[o + 1] = hy * il; n[o + 2] = c2 * il;\n    }\n  }\n  nrmAttr.needsUpdate = true;\n}\nlet geomDirty = true;\nfunction syncGeom() {\n  const a = posAttr.array;\n  for (let i = 0; i < RES * RES; i++) a[i * 3 + 2] = heights[i];\n  posAttr.needsUpdate = true;\n  updateNormals();\n}\nupdateNormals();\n\n/* ---------- sculpting ---------- */\nfunction applyBrush(p, dt) {\n  const cx = (p.x + SIZE / 2) / CELL, cy = (p.z + SIZE / 2) / CELL;\n  const gr = brushRadius / CELL;\n  const x0 = Math.max(0, Math.floor(cx - gr)), x1 = Math.min(RES - 1, Math.ceil(cx + gr));\n  const y0 = Math.max(0, Math.floor(cy - gr)), y1 = Math.min(RES - 1, Math.ceil(cy + gr));\n  const s = brushStrength;\n  for (let iy = y0; iy <= y1; iy++) {\n    for (let ix = x0; ix <= x1; ix++) {\n      const dx = (ix - cx) / gr, dy = (iy - cy) / gr;\n      const d2 = dx * dx + dy * dy;\n      if (d2 > 1) continue;\n      const t = 1 - Math.sqrt(d2), w = t * t * (3 - 2 * t);\n      const i = iy * RES + ix, h = heights[i];\n      if (mode === 'raise')        heights[i] = h + s * 30 * dt * w;\n      else if (mode === 'lower')   heights[i] = h - s * 30 * dt * w;\n      else if (mode === 'smooth') {\n        const l = heights[iy * RES + Math.max(0, ix - 1)], r = heights[iy * RES + Math.min(RES - 1, ix + 1)];\n        const u = heights[Math.max(0, iy - 1) * RES + ix], dn = heights[Math.min(RES - 1, iy + 1) * RES + ix];\n        heights[i] = h + ((l + r + u + dn) * .25 - h) * Math.min(1, s * 8 * dt) * w;\n      }\n      else if (mode === 'flatten') heights[i] = h + (flattenTarget - h) * Math.min(1, s * 8 * dt) * w;\n      if (heights[i] < HMIN) heights[i] = HMIN; else if (heights[i] > HMAX) heights[i] = HMAX;\n    }\n  }\n  geomDirty = true;\n}\n\n/* ---------- input ---------- */\nconst raycaster = new THREE.Raycaster();\nconst ndc = new THREE.Vector2();\nconst hitPoint = new THREE.Vector3();\nlet pointerIn = false, painting = false, hasHit = false;\nlet flattenTarget = 0, strokeStart = false;\nconst pointers = new Set();\nconst el = renderer.domElement;\nconst setNDC = e => {\n  const r = el.getBoundingClientRect();\n  ndc.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);\n};\nel.addEventListener('pointermove', e => { setNDC(e); pointerIn = true; });\nel.addEventListener('pointerdown', e => {\n  pointers.add(e.pointerId);\n  if (pointers.size > 1) { painting = false; return; }\n  if (e.button === 0) {\n    setNDC(e); pointerIn = true;\n    painting = true; strokeStart = true;\n    try { el.setPointerCapture(e.pointerId); } catch (_) {}\n  }\n});\nconst endStroke = e => { pointers.delete(e.pointerId); if (pointers.size === 0) painting = false; };\nel.addEventListener('pointerup', endStroke);\nel.addEventListener('pointercancel', endStroke);\nel.addEventListener('pointerleave', () => { pointerIn = false; });\nel.addEventListener('contextmenu', e => e.preventDefault());\nwindow.addEventListener('blur', () => { painting = false; pointers.clear(); });\n\n/* ---------- UI wiring ---------- */\nconst $ = id => document.getElementById(id);\nfunction setMode(m) {\n  mode = m;\n  document.querySelectorAll('.mode').forEach(b => b.classList.toggle('active', b.dataset.mode === m));\n  ringMat.color.setHex(MODES[m].color);\n  discMat.color.setHex(MODES[m].color);\n}\nsetMode('raise');\ndocument.querySelectorAll('.mode').forEach(b => b.addEventListener('click', () => setMode(b.dataset.mode)));\n\nconst sizeEl = $('size'), strEl = $('strength'), waterEl = $('water'), snowEl = $('snow');\nlet miniDirty = true;\nsizeEl.addEventListener('input', () => { brushRadius = +sizeEl.value; $('sizeVal').textContent = brushRadius.toFixed(1); });\nstrEl.addEventListener('input', () => { brushStrength = +strEl.value / 100; $('strVal').textContent = strEl.value + '%'; });\nwaterEl.addEventListener('input', () => { waterLevel = +waterEl.value; $('waterVal').textContent = waterLevel.toFixed(1); miniDirty = true; });\nsnowEl.addEventListener('input', () => { snowH = +snowEl.value; $('snowVal').textContent = snowH; miniDirty = true; });\n$('grid').addEventListener('change', e => { showGrid = e.target.checked; });\n\nwindow.addEventListener('keydown', e => {\n  if (e.key >= '1' && e.key <= '4') setMode(['raise', 'lower', 'smooth', 'flatten'][+e.key - 1]);\n  else if (e.key === '[') { sizeEl.value = Math.max(2, +sizeEl.value - 2); sizeEl.dispatchEvent(new Event('input')); }\n  else if (e.key === ']') { sizeEl.value = Math.min(40, +sizeEl.value + 2); sizeEl.dispatchEvent(new Event('input')); }\n  else if (e.key === 'g' || e.key === 'G') { $('grid').checked = !$('grid').checked; showGrid = $('grid').checked; }\n});\n\n$('reset').addEventListener('click', () => { heights.fill(0); geomDirty = true; });\n$('export').addEventListener('click', () => {\n  const c = document.createElement('canvas'); c.width = c.height = RES;\n  const x = c.getContext('2d'), img = x.createImageData(RES, RES);\n  for (let i = 0; i < RES * RES; i++) {\n    const v = Math.round(Math.min(Math.max((heights[i] - HMIN) / (HMAX - HMIN), 0), 1) * 255);\n    img.data[i * 4] = img.data[i * 4 + 1] = img.data[i * 4 + 2] = v;\n    img.data[i * 4 + 3] = 255;\n  }\n  x.putImageData(img, 0, 0);\n  const a = document.createElement('a');\n  a.download = 'terraforge-heightmap.png';\n  a.href = c.toDataURL('image/png');\n  a.click();\n});\n\n/* ---------- minimap ---------- */\nconst mini = $('minimap'), mctx = mini.getContext('2d');\nconst miniOff = document.createElement('canvas'); miniOff.width = miniOff.height = RES;\nconst miniOffCtx = miniOff.getContext('2d');\nconst miniImg = miniOffCtx.createImageData(RES, RES);\nconst smoothstep = (a, b, x) => { const t = Math.min(Math.max((x - a) / (b - a), 0), 1); return t * t * (3 - 2 * t); };\nfunction updateMinimapBase() {\n  const d = miniImg.data, H = heights, c2 = 2 * CELL;\n  for (let iy = 0; iy < RES; iy++) {\n    const yu = iy > 0 ? iy - 1 : 0, yd = iy < RES - 1 ? iy + 1 : RES - 1;\n    for (let ix = 0; ix < RES; ix++) {\n      const i = iy * RES + ix, h = H[i];\n      const hx = H[iy * RES + Math.min(RES - 1, ix + 1)] - H[iy * RES + Math.max(0, ix - 1)];\n      const hy = H[yd * RES + ix] - H[yu * RES + ix];\n      const il = 1 / Math.hypot(hx, hy, c2);\n      const ny = c2 * il, slope = 1 - ny;                  // world normal y\n      const wnx = -hx * il, wny = c2 * il, wnz = -hy * il; // world-space normal\n      const shade = .55 + .5 * Math.max(0, wnx * LIGHT_DIR.x + wny * LIGHT_DIR.y + wnz * LIGHT_DIR.z);\n      const rockS = smoothstep(.30, .52, slope);\n      const rockF = Math.max(rockS, smoothstep(33, 47, h) * .85);\n      const snowF = smoothstep(snowH - 5, snowH + 5, h) * (1 - rockS * .85);\n      let r = 96 + (118 - 96) * rockF, g = 138 + (114 - 138) * rockF, b = 64 + (104 - 64) * rockF;\n      r += (240 - r) * snowF; g += (243 - g) * snowF; b += (250 - b) * snowF;\n      const sandF = smoothstep(waterLevel + 3.5, waterLevel + .8, h) * smoothstep(waterLevel - 14, waterLevel - 2, h);\n      r += (196 - r) * sandF * (1 - snowF); g += (178 - g) * sandF * (1 - snowF); b += (130 - b) * sandF * (1 - snowF);\n      if (h < waterLevel) {                                // submerged → water overlay\n        const a = Math.min(.25 + (waterLevel - h) / 10, .88);\n        r += (30 - r) * a; g += (110 - g) * a; b += (150 - b) * a;\n      }\n      const o = i * 4;\n      d[o] = r * shade; d[o + 1] = g * shade; d[o + 2] = b * shade; d[o + 3] = 255;\n    }\n  }\n  miniOffCtx.putImageData(miniImg, 0, 0);\n}\nfunction drawMinimap() {\n  mctx.imageSmoothingEnabled = true;\n  mctx.drawImage(miniOff, 0, 0, RES, RES);\n  const k = RES / SIZE;\n  // camera marker + view direction\n  const cx = (camera.position.x + SIZE / 2) * k, cy = (camera.position.z + SIZE / 2) * k;\n  const tx = (controls.target.x + SIZE / 2) * k, ty = (controls.target.z + SIZE / 2) * k;\n  mctx.strokeStyle = 'rgba(255,255,255,.55)'; mctx.lineWidth = 1;\n  mctx.beginPath(); mctx.moveTo(cx, cy); mctx.lineTo(tx, ty); mctx.stroke();\n  mctx.fillStyle = '#fff';\n  mctx.beginPath(); mctx.arc(cx, cy, 2.5, 0, 7); mctx.fill();\n  // brush marker\n  if (hasHit && (pointerIn || painting)) {\n    mctx.strokeStyle = MODES[mode].css; mctx.lineWidth = 1.5;\n    mctx.beginPath();\n    mctx.arc((hitPoint.x + SIZE / 2) * k, (hitPoint.z + SIZE / 2) * k, brushRadius * k, 0, 7);\n    mctx.stroke();\n  }\n}\n\n/* ---------- brush indicator update ---------- */\nfunction updateBrush(p) {\n  const r = brushRadius;\n  discPos[0] = p.x; discPos[1] = p.y + .45; discPos[2] = p.z;\n  for (let k = 0; k < RSEG; k++) {\n    const a = k / RSEG * Math.PI * 2;\n    const wx = p.x + Math.cos(a) * r, wz = p.z + Math.sin(a) * r;\n    const wy = sampleH(wx, wz) + .45;\n    ringPos[k * 3] = wx; ringPos[k * 3 + 1] = wy; ringPos[k * 3 + 2] = wz;\n    discPos[(k + 1) * 3] = wx; discPos[(k + 1) * 3 + 1] = wy; discPos[(k + 1) * 3 + 2] = wz;\n  }\n  ringGeo.attributes.position.needsUpdate = true;\n  discGeo.attributes.position.needsUpdate = true;\n}\n\n/* ---------- main loop ---------- */\nconst readout = $('readout');\nlet last = performance.now();\nfunction tick(now) {\n  requestAnimationFrame(tick);\n  const dt = Math.min((now - last) / 1000, .05); last = now;\n  controls.update();\n\n  if (pointerIn || painting) {\n    raycaster.setFromCamera(ndc, camera);\n    const hits = raycaster.intersectObject(terrain, false);\n    hasHit = hits.length > 0;\n    if (hasHit) hitPoint.copy(hits[0].point);\n  }\n  if (hasHit && (pointerIn || painting)) {\n    brushGroup.visible = true;\n    updateBrush(hitPoint);\n    readout.textContent =\n      `h ${hitPoint.y.toFixed(1)}  ·  x ${hitPoint.x.toFixed(0)}  z ${hitPoint.z.toFixed(0)}  ·  ${mode}`;\n  } else {\n    brushGroup.visible = false;\n    readout.textContent = 'hover terrain to inspect';\n  }\n  if (painting && hasHit) {\n    if (strokeStart) { flattenTarget = hitPoint.y; strokeStart = false; }\n    applyBrush(hitPoint, dt);\n  }\n  if (geomDirty) { syncGeom(); geomDirty = false; miniDirty = true; }\n\n  const sh = terrMat.userData.sh;\n  if (sh) {\n    sh.uniforms.uWater.value = waterLevel;\n    sh.uniforms.uSnowH.value = snowH;\n    sh.uniforms.uShowGrid.value = showGrid ? 1 : 0;\n  }\n  water.position.y = waterLevel;\n  waterTex.offset.x += dt * .008; waterTex.offset.y += dt * .005;\n\n  if (miniDirty) { updateMinimapBase(); miniDirty = false; }\n  drawMinimap();\n  renderer.render(scene, camera);\n}\nrequestAnimationFrame(tick);\n\nwindow.addEventListener('resize', () => {\n  camera.aspect = innerWidth / innerHeight;\n  camera.updateProjectionMatrix();\n  renderer.setSize(innerWidth, innerHeight);\n});\n</script>\n</body>\n</html>"
