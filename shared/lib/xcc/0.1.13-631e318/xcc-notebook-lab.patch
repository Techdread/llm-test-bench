--- /dev/null
+++ b/libsrc/_wasm/unistd/clock.c
@@ -0,0 +1,22 @@
+// Notebook Lab patch: clock() counts microseconds from the program's first
+// call, on WASI's monotonic clock (CLOCKS_PER_SEC is 1000000).
+#include "time.h"
+#include "stdint.h"
+#include "../wasi.h"
+
+clock_t clock(void) {
+  static uint64_t start;
+  static int started;
+  uint64_t now;
+  if (clock_time_get(CLOCK_MONOTONIC, 1000, &now) != 0)
+    return (clock_t)-1;
+  if (!started) {
+    start = now;
+    started = 1;
+  }
+  return (clock_t)((now - start) / 1000);
+}
+
+double difftime(time_t end, time_t start) {
+  return (double)(end - start);
+}
